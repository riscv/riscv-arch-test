# imperas.ic
# Initialization file for rv32gc Imperas ISS
# David_Harris@hmc.edu 23 March 2026
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1

# Base configuration
--processorvendor riscv.ovpworld.org
--processorname riscv
--variant RV32GCV
# defines printing via write to  0x10010000 and termination at symbol _test_exit
--extlib iss/cpu0/cc=riscv.ovpworld.org/intercept/customControl/1.0
--override iss/cpu0/simulateexceptions=T
--override iss/cpu0/defaultsemihost=F

# Bit manipulation
--override cpu*/add_Extensions=B
--override cpu*/misa_B_Zba_Zbb_Zbs=T

# Cache block operations
--override cpu*/Zicbom=T
--override cpu*/Zicbop=T
--override cpu*/Zicboz=T
--override cmomp_bytes=64  # Zic64b
--override cmoz_bytes=64   # Zic64b
--override lr_sc_grain=4   # Za64rs requires <=64; we use native word size

# Virtual memory
--override cpu*/Sv_modes=3 # SV32 supported
--override cpu*/Svadu=T # Enable SVADU hardware update of A/D bits when menvcfg.ADUE=1
--override cpu*/Svinval=T

# Crypto extensions
--override cpu*/Zkr=T # Zkr entropy source and seed register
--override cpu*/mnoise_undefined=T # nonratified mnoise register not implemented
--override cpu*/Zk=T
--override cpu*/Zks=T
--override cpu*/Zbk=T
--override cpu*/Zbkb=T
--override cpu*/Zbkx=T
--override cpu*/Zknd=T
--override cpu*/Zkne=T
--override cpu*/Zknh=T
--override cpu*/Zksed=T
--override cpu*/Zksh=T

# Vector extensions
--override cpu*/EEW_index=0 #(Uns32) (default=0) (default) Override maximum supported index EEW (use ELEN if zero)
--override cpu*/ELEN=64 #(Uns32) (default=64) (default) Override ELEN
--override cpu*/SEW_min=8 #(Uns32) (default=8) (default) Override minimum supported SEW
--override cpu*/VLEN=0x200 #(Uns32) (default=0x200) (default) Override VLEN
--override cpu*/Zve32f=T #(Boolean) (default=F) (default) Specify that Zve32f is implemented
--override cpu*/Zve32x=T #(Boolean) (default=F) (default) Specify that Zve32x is implemented
--override cpu*/Zve64d=T #(Boolean) (default=F) (default) Specify that Zve64d is implemented
--override cpu*/Zve64f=T #(Boolean) (default=F) (default) Specify that Zve64f is implemented
--override cpu*/Zve64x=T #(Boolean) (default=F) (default) Specify that Zve64x is implemented
--override cpu*/Zvfbfmin=T #(Boolean) (default=T) (default) Specify that Zvfbfmin is implemented
--override cpu*/Zvfbfwma=T #(Boolean) (default=T) (default) Specify that Zvfbfwma is implemented
--override cpu*/Zvfh=T #(Boolean) (default=T) (default) Specify that Zvfh is implemented
--override cpu*/Zvfhmin=T #(Boolean) (default=T) (default) Specify that Zvfhfmin is implemented
--override cpu*/agnostic_mask=F #(Boolean) (default=F) (default) Specify that artifact mask registers holding agnostic bits are present
--override cpu*/agnostic_ones=F #(Boolean) (default=F) (default) Specify that vector agnostic elements are set to 1
--override cpu*/align_whole=F #(Boolean) (default=F) (default) Whether whole-register load addresses must be aligned using the encoded EEW
--override cpu*/mstatus_VS=0 #(Uns32) (default=0) (default) Override default value of mstatus.VS (initial state of vector unit)
--override cpu*/mstatus_vs_mode=state_update #(Enumeration) (default=state_update) (default) Specify conditions causing update of mstatus.VS to dirty
--override cpu*/unalignedV=F #(Boolean) (default=F) (default) Specify whether the processor supports unaligned memory accesses for vector instructions
--override cpu*/vector_version=1.0-ratified #(Enumeration) (default=1.0-ratified) (default) Specify required Vector Architecture version
--override cpu*/vill_trap=F #(Boolean) (default=F) (default) Whether illegal vtype values cause trap instead of setting vtype.vill
--override cpu*/vstart0_ld_st=F #(Boolean) (default=F) (default) Whether CSR vstart must be 0 for load/store vector instructions
--override cpu*/vstart0_non_ld_st=F #(Boolean) (default=F) (default) Whether CSR vstart must be 0 for non-load/store vector instructions

# Miscellaneous extensions
--override cpu*/Zicond=T
--override cpu*/Zfh=T
--override cpu*/Zfa=T
--override cpu*/Zcb=T
--override cpu*/Zabha=T
--override cpu*/Zacas=T
--override cpu*/Zfbfmin=T
--override cpu*/Sstc=T
--override cpu*/Zimop=T
--override cpu*/Zcmop=T

# Misaligned access (Zicclsm)
--override cpu*/unaligned=T

# PMP Configuration
--override cpu*/PMP_registers=16
--override cpu*/PMP_grain=4   # 64-byte grains to match cache line width
--override cpu*/PMP_decompose=T  # unaligned accesses are decomposed into separate aligned accesses
--override cpu*/PMP_undefined=T # access to unimplemented PMP registers cause illegal instruction exception

# More extensions
#--override cpu*/Smdbltrp=T
#--override cpu*/Ssdbltrp=T

# PMA Settings
# 'r': read access allowed
# 'w': write access allowed
# 'x': execute access allowed
# 'a': aligned access required
# 'A': atomic instructions NOT allowed (actually USER1 privilege needed)
# 'P': push/pop instructions NOT allowed (actually USER2 privilege needed)
# '1': 1-byte accesses allowed
# '2': 2-byte accesses allowed
# '4': 4-byte accesses allowed
# '8': 8-byte accesses allowed
# '-', space: ignored (use for input string formatting).
#
# SVxx Memory 0x0000000000 0x7FFFFFFFFF
#
--callcommand iss/cpu0/setPMA -lo 0x0000000000 -hi 0xFFFFFFFFFF -attributes " ---a-- ---- " # All memory inaccessible unless defined otherwise
--callcommand iss/cpu0/setPMA -lo 0x0000000000 -hi 0x7FFFFFFFFF -attributes " ---a-- ---- " # INITIAL
--callcommand iss/cpu0/setPMA -lo 0x0002000000 -hi 0x000200FFFF -attributes " rw-aA- 1248 " # CLINT
--callcommand iss/cpu0/setPMA -lo 0x000C000000 -hi 0x000FFFFFFF -attributes " rw-aA- --4- " # PLIC
--callcommand iss/cpu0/setPMA -lo 0x0010010000 -hi 0x0010010007 -attributes " rw-aA- 1248 " # UART0
--callcommand iss/cpu0/setPMA -lo 0x0080000000 -hi 0x008FFFFFFF -attributes " rwx--- 1248 " # UNCORE_RAM
