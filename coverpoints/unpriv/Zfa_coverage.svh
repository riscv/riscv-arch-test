`endif
function void zfa_sample(int hart, int issue, ins_t ins);

    case (traceDataQ[hart][issue][0].inst_name)
`ifdef D_SUPPORTED
        "fcvtmod.w.d"     : begin
            ZfaD_fcvtmod_w_d_cg.sample(ins);
        end
`endif
`ifdef D_SUPPORTED
        "fleq.d"     : begin
            ZfaD_fleq_d_cg.sample(ins);
        end
`endif
        "fleq.h"     : begin
`ifdef ZFH_SUPPORTED
            ZfaZfh_fleq_h_cg.sample(ins);
`endif
`ifdef ZFH_SUPPORTED
`ifdef D_SUPPORTED
            ZfaZfhD_fleq_h_cg.sample(ins);
`endif
`endif
        end
        "fleq.s"     : begin
            Zfa_fleq_s_cg.sample(ins);
`ifdef D_SUPPORTED
            ZfaD_fleq_s_cg.sample(ins);
`endif
        end
`ifdef D_SUPPORTED
        "fli.d"     : begin
            ZfaD_fli_d_cg.sample(ins);
        end
`endif
        "fli.h"     : begin
`ifdef ZFH_SUPPORTED
            ZfaZfh_fli_h_cg.sample(ins);
`endif
`ifdef ZFH_SUPPORTED
`ifdef D_SUPPORTED
            ZfaZfhD_fli_h_cg.sample(ins);
`endif
`endif
