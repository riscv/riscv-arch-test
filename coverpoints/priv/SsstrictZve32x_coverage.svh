    cp_ssstrictv_masking_vs2_eq_v0 : cross std_trap_vec, vtype_lmul_1, vs2_is_v0_meqv0, mask_enabled;

//// end cp_ssstrictv_masking_vs2_eq_v0 //////////////////////////////////////////////////////////////////////////////////////////////

// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_vwidenw_overlapping_vd_vs1_lmul1
// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // Widening .w with LMUL=1: vs1 = vd overlaps low part of destination group, must trap

    cp_ssstrictv_vwidenw_overlapping_vd_vs1_lmul1: cross std_trap_vec, vtype_lmul_1, vd_reg_aligned_lmul_2, vd_eq_vs1, vs2_vd_no_overlap_lmul1;

//// end cp_ssstrictv_vwidenw_overlapping_vd_vs1_lmul1 /////////////////////////////////////////////////////////

// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_widening_source_overlap
// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // Widening with vs2 == vs1: same register read at different EEWs, must trap
    vtype_lmul_widen_src: coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") {
        bins half = {7};
        bins one  = {0};
        bins two  = {1};
        bins four = {2};
    }


    cp_ssstrictv_widening_source_overlap: cross std_trap_vec, vtype_lmul_widen_src, vs2_eq_vs1;

//// end cp_ssstrictv_widening_source_overlap ///////////////////////////////////////////////////////////////

endgroup
