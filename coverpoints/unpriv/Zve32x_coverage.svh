        `ifdef UDB_MXLEN_32
        wildcard bins sew32     = {34'b10_11111111_11111111_11111111_111?????};
        `endif

        `ifdef UDB_MXLEN_64
        wildcard bins sew32     = {66'b10_????????_????????_????????_????????_11111111_11111111_11111111_111?????};
        `endif
    }

