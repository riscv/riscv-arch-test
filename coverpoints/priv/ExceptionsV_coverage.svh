    // so that a transitioning model can be cross-checked against an always-Dirty
    // model via signature comparison.
    //////////////////////////////////////////////////////////////////////////////////

    //// end cp_vectorfp_mstatus_fs_state_nonaffecting////////////////////////////////////////////////

