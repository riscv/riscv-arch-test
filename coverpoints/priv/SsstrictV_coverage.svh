function void ssstrictv_sample(int hart, int issue, ins_t ins);

    case (traceDataQ[hart][issue][0].inst_name)
        "vaadd.vv"     : begin
            SsstrictV_vaadd_vv_cg.sample(ins);
        end
        "vaadd.vx"     : begin
            SsstrictV_vaadd_vx_cg.sample(ins);
        end
        "vaaddu.vv"     : begin
            SsstrictV_vaaddu_vv_cg.sample(ins);
        end
