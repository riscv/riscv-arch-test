                      ins.current.insn[31:29]} {
        bins seg_overflow = {{5'd31, 3'b001},  // NFIELDS=2, vd=31
                             {5'd30, 3'b010},  // NFIELDS=3, vd=30
                             {5'd29, 3'b011},  // NFIELDS=4, vd=29
