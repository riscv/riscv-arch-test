    cp_ssstrictv_masking_vs2_eq_v0 : cross std_trap_vec, vtype_lmul_1, vs2_is_v0_meqv0, mask_enabled;

//// end cp_ssstrictv_masking_vs2_eq_v0 //////////////////////////////////////////////////////////////////////////////////////////////

// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_vext4_overlapping_vd_vs2
// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // vf4 extending with LMUL=4: vs2 overlaps bottom 3/4 of vd group, must trap

    // vs2 is not the highest register in the 4-register vd group (offset != 3)
    vs2_not_top_of_group_4: coverpoint ins.current.insn[21:20] {
        bins bottom = {[2'b00:2'b10]};
    }

    cp_ssstrictv_vext4_overlapping_vd_vs2: cross std_trap_vec, vtype_lmul_4, vd_reg_aligned_lmul_4, vs2_vd_overlap_lmul2, vs2_not_top_of_group_4;

//// end cp_ssstrictv_vext4_overlapping_vd_vs2 ///////////////////////////////////////////////////////////////

endgroup
// ---------------------
function void ssstrictzve32x_sample(int hart, int issue, ins_t ins);
    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 0 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (traceDataQ[hart][issue][0].inst_name)
        "vaadd.vv"     : begin
            SsstrictZve32x_vaadd_vv_cg.sample(ins);
        end
        "vaadd.vx"     : begin
            SsstrictZve32x_vaadd_vx_cg.sample(ins);
        end
        "vaaddu.vv"     : begin
            SsstrictZve32x_vaaddu_vv_cg.sample(ins);
        end
        "vaaddu.vx"     : begin
            SsstrictZve32x_vaaddu_vx_cg.sample(ins);
        end
        "vadc.vim"     : begin
            SsstrictZve32x_vadc_vim_cg.sample(ins);
        end
        "vadc.vvm"     : begin
            SsstrictZve32x_vadc_vvm_cg.sample(ins);
        end
        "vadc.vxm"     : begin
            SsstrictZve32x_vadc_vxm_cg.sample(ins);
        end
        "vadd.vi"     : begin
            SsstrictZve32x_vadd_vi_cg.sample(ins);
        end
        "vadd.vv"     : begin
            SsstrictZve32x_vadd_vv_cg.sample(ins);
        end
        "vadd.vx"     : begin
            SsstrictZve32x_vadd_vx_cg.sample(ins);
        end
        "vand.vi"     : begin
            SsstrictZve32x_vand_vi_cg.sample(ins);
        end
        "vand.vv"     : begin
            SsstrictZve32x_vand_vv_cg.sample(ins);
        end
        "vand.vx"     : begin
            SsstrictZve32x_vand_vx_cg.sample(ins);
        end
        "vasub.vv"     : begin
            SsstrictZve32x_vasub_vv_cg.sample(ins);
        end
        "vasub.vx"     : begin
            SsstrictZve32x_vasub_vx_cg.sample(ins);
        end
        "vasubu.vv"     : begin
            SsstrictZve32x_vasubu_vv_cg.sample(ins);
        end
        "vasubu.vx"     : begin
            SsstrictZve32x_vasubu_vx_cg.sample(ins);
        end
        "vcompress.vm"     : begin
            SsstrictZve32x_vcompress_vm_cg.sample(ins);
