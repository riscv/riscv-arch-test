covergroup ExceptionsZve64x_vl1re16_v_sew64_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // std_trap_vec
    //////////////////////////////////////////////////////////////////////////////////

    std_trap_vec : coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vill") == 0 &
                        get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) == 0 &
                        get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) != 0 &
                        get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "vs") != 0
                    }
    {
        bins true = {1'b1};
    }

    //// end std_trap_vec ////////////////////////////////////////////////

    // //////////////////////////////////////////////////////////////////////////////////////////////////////////
    // cp_exceptionsv_address_fault_laod
    // //////////////////////////////////////////////////////////////////////////////////////////////////////////

    `ifdef RVMODEL_ACCESS_FAULT_ADDRESS_LOAD
        // Helper: valid vector type (vill=0)
        vtype_valid_20000f: coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vill") {
            bins valid = {1'b0};
        }

        illegal_address: coverpoint ins.current.rs1_val {
            bins illegal = {`RVMODEL_ACCESS_FAULT_ADDRESS_LOAD};
        }

        // Cross: valid vtype AND trap occurred
        cp_exceptionsv_address_fault: cross vtype_valid_20000f, illegal_address;
    `endif

//// end cp_exceptionsv_address_fault_load ///////////////////////////////////////////////////////////////////////////

// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_misalignv_ls_wholereg_misaligned
// //////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Exercise whole-register vector load/store (vl<nf>r / vs<nf>r) instructions
// whose base address is not naturally aligned to max(EEW/8, SEWMIN/8).
// Implementations are permitted to raise a misaligned-address exception on
// such accesses or to complete them successfully; both outcomes are valid.
// This coverpoint samples occurrence of the misaligned base with a valid
// vtype and is intended to be applied to the whole-register L/S instruction
// list.


    vtype_valid_0293c6: coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vill") {
        bins valid = {1'b0};
    }

    // Non-zero low bits of the base address indicate misalignment relative to
    // any supported EEW of 2 bytes or larger.
    base_misalign_0293c6 : coverpoint ins.current.rs1_val[2:0] {
        bins offsets[] = {[3'b001:3'b111]};
    }

    cp_misalignv_ls_wholereg_misaligned : cross vtype_valid_0293c6, base_misalign_0293c6;

//// end cp_misalignv_ls_wholereg_misaligned ///////////////////////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vstart
    //////////////////////////////////////////////////////////////////////////////////

    cp_vstart: coverpoint vstart_check_vl(ins.hart, ins.issue, get_vlmax_params(ins.hart, ins.issue, 3'b001, 3'b000)) {
        bins vstart_one     = {vstart_one};
        bins vstart_vlmaxm1 = {vstart_vlmaxm1};
        bins vstart_vlmaxd2 = {vstart_vlmaxd2};
        bins vstart_legal   = {vstart_legal};   // random vstart
    }

    //// end cp_vstart////////////////////////////////////////////////

endgroup
