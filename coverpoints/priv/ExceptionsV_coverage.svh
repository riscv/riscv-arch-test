    base_misalign_42737e : coverpoint ins.current.rs1_val[2:0] {
        bins offsets[] = {[3'b001:3'b111]};
    }

    cp_misalignv_ls_element_misaligned : cross vtype_valid_42737e, base_misalign_42737e;

