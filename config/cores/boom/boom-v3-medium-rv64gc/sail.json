{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.16/sail_riscv_config_schema.json",
  "base": {
    "xlen": 64,
    "E": false,
    // Whether a `mhpmcounter` increments if the event it is counting
    // was generated during a write to its corresponding `mhpmevent`
    // CSR (which could change the monitored event).
    // BOOM registers the event increments a cycle before the CSR file adds them (BOOM
    // src/main/scala/v3/exu/core.scala:283), so a write to mhpmevent does not count the events of
    // the writing instruction with the new selector.
    "hpmcounter_increments_in_self_hpmevent_write": false,
    // The precision of the HPM counter, upto 64 bits.
    // rocket-chip CSR file: hpmWidth = 40 (rocket-chip src/main/scala/rocket/CSR.scala:212).
    "hpmcounter_width_bits": 40,
    // The width of the `mhpmevent` CSRs, upto 64 bits, if Sscofpmf is
    // not supported.  On RV32 without Sscofpmf, this can be upto 32,
    // since the `mhpmeventh` CSRs are not accessible.
    // If Sscofpmf is supported, the `mhpmevent` CSRs are always 64
    // bits; this value then defines the number, upto 56, of the lowest
    // bits of the CSRs that are used as the event selector.
    // BOOM: mhpmevent keeps bits 1:0 (event set, 3 sets) and 13:8 (event mask, 6 events in the
    // largest set): rocket-chip src/main/scala/rocket/Events.scala:29-35 and BOOM
    // src/main/scala/v3/exu/core.scala:247-270. Bits 7:2 read 0 on BOOM; Sail models only a low
    // field.
    "hpmevent_width_bits": 14,
    // mcountinhibit has 3 + nPerfCounters = 9 bits: CY, IR and HPM3-8 are writable
    // (rocket-chip src/main/scala/rocket/CSR.scala:591,1308).
    "mcountinhibit": {
      // Whether the `mcountinhibit` CSR is implemented.
      "supported": true,
      // This bits in this value control whether the corresponding
      // bits of the CSR are writable.  Note that bit 1 cannot be written
      // to as it is read-only zero.
      "writable_bits": { "len": 32, "value": "0x0000_01FD" }
    },
    "writable_fiom": true,
    // nPerfCounters = 6: mhpmcounter3-8 (BOOM src/main/scala/v3/common/config-mixins.scala:155).
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x0000_01F8"
    },
    // delegable_counters = bits 0-8 (rocket-chip src/main/scala/rocket/CSR.scala:530-538).
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x0000_01FF"
    },
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0x0000_01FF"
    },
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0x0000_0000"
    },
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
