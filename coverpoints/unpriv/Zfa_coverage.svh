`endif
`ifdef D_SUPPORTED
        "fmvp.d.x"     : begin
            ZfaD_fmvp_d_x_cg.sample(ins);
        end
`endif
`endif
        default: ; // a case needs at least one item, and some configurations select none
    endcase
endfunction
