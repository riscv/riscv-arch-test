    //// end cp_mstatus_vs_off////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vectorfp_mstatus_fs_state
    // Sample the vector-FP instruction under each non-Off mstatus.FS starting
