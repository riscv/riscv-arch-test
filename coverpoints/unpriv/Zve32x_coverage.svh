    // cp_custom_maskwrite_masked
    //////////////////////////////////////////////////////////////////////////////////

    // Custom coverpoints for Vector mask producing/writing operations where masked CAN be enabled

    // ensures vd updates
    // cross vtype_prev_vill_clear, vstart_zero, vl_nonzero, no_trap;
