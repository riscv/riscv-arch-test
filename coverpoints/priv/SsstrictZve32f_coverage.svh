        end
        "vfsgnjx.vf"     : begin
            SsstrictZve32f_vfsgnjx_vf_cg.sample(ins);
        end
        "vfsgnjx.vv"     : begin
            SsstrictZve32f_vfsgnjx_vv_cg.sample(ins);
        end
        "vfslide1down.vf"     : begin
            SsstrictZve32f_vfslide1down_vf_cg.sample(ins);
