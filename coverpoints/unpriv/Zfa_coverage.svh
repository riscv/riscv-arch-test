        bins neginfinity      = {32'h0fff_FC00};
        // Any positive quiet/signaling NaN in the low 16 bits with improper boxing
        wildcard bins posQNaN = {32'b????????????????_0111111?????????};
        wildcard bins posSNaN = {
            32'b????????????????_01111101????????,
            32'b????????????????_011111001???????,
            32'b????????????????_0111110001??????,
            32'b????????????????_01111100001?????,
