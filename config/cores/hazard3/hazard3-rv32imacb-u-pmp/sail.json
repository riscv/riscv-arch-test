// Sail reference-model configuration for the Hazard3 core (the RP2350 CPU).
//
// Written against Wren6991/Hazard3 commit 8af992930f71a69b0e06c38734c1094f41a05ca0 (v1.1.1).
// Every non-obvious value cites the supporting text plus a permalink pinned to that commit.
// Must stay consistent with hazard3-rv32imacb-u-pmp.yaml and link.ld.
{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.14.1/sail_riscv_config_schema.json",
  "base": {
    "xlen": 32,
    "E": false,
    "writable_misa": false,
    // menvcfg / menvcfgh are decoded but every field is tied to 0, so FIOM is not writable.
    //   Quote: "MENVCFG is seemingly mandatory as of M-mode v1.12, if U-mode is implemented.
    //   All of its fields are tied to 0 in our implementation."
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/hdl/hazard3_csr.v#L806-L816
    "writable_fiom": false,
    // Hazard3 hardwires mhpmcounter3..31 and mhpmevent3..31 to 0, so no HPM counter exists.
    //   Quote: "==== mhpmcounter3...31 / Address: `0xb03` through `0xb1f` / Hardwired to 0."
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L350-L352
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x0000_0000"
    },
    // Hazard3 has no S-mode, so scounteren does not exist and every bit is read-only zero.
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // The bits in this value control whether the corresponding bits
    // of the `mcounteren` CSR that control access to HPM counters,
    // and `cycle`, `time` and `instret` registers at lower privilege
    // modes, are read-only zero. A set bit specifies that the
    // corresponding bit of `mcounteren` is writable, otherwise the
    // bit is read-only zero.
    // mcounteren exists because U-mode does. CY (0), TM (1) and IR (2) are writable; TM has
    // no hardware effect because there is no time CSR, but the field still exists so that
    // M-mode software can decide to emulate U-mode time reads. Bits 3..31 are RES0 because
    // no HPM counter exists.
    //   Quote: "| 31:3 | - | RES0 | 2 | `ir` | ... | 1 | `tm` | No hardware effect, as the
    //   `time`/`timeh` CSRs are not implemented. However, this field still exists ... | 0 | `cy` |"
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L273-L277
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0x7"
    },
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // `mtvec.{direct,vectored}.supported` indicates whether the
    // corresponding mode is supported for `mtvec`.  At least one mode
    // should be supported.  If both modes are supported, the mode on
    // reset is unspecified.
    // The `mtvec.{direct,vectored}.base_alignment` parameters control the alignment
    // of the trap vector base for each mode.  The alignment is
    // specified as the power of 2 of the desired byte alignment, and
    // can range from a minimum of 2 upto a maximum of 24. If
    // unaligned values are written to these CSRs, the lowest bits
    // will be zeroed to respect the specified alignment.
    // Hazard3 reads mtvec back as {mtvec[31:2], 1'b0, irq_vector_enable}: BASE keeps all 30
    // bits (base_alignment 2) in both modes, mode bit 1 is hardwired 0, and both Direct and
    // Vectored are supported. Must agree with MTVEC_MODES and MTVEC_BASE_ALIGNMENT_* in the
    // UDB config.
    //   Quote: "rdata = { mtvec[XLEN-1:2],  // BASE  1'b0, // Reserved mode bit gets WARL'd to 0
    //   irq_vector_enable // MODE is vectored (2'h1) or direct (2'h0) };"
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/hdl/hazard3_csr.v#L860-L868
    // NOTE: in Vectored mode Hazard3 ORs the offset into BASE rather than adding it. Sail
    // adds. They agree whenever BASE is aligned to the rounded-up table size, which ACT's
    // 64-byte-aligned M-mode trampoline satisfies.
    //   Quote: "In Vectored mode, this is _OR'd_ with the trap offset ... so the table must be
    //   aligned to its total size, rounded up to a power of 2."
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L197
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 2
      }
    },
    // Similar to `mtvec` above. If `S` mode is not supported, these
    // values need to be present and legal but are ignored.
    "stvec": {
      // The spec requires `base_alignment` for `stvec.direct` to be 2
      // (i.e. 4-byte alignment), hence there is no configuration
      // parameter for it.
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "vstvec": {
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "medeleg": {
      // medeleg is not implemented at all: no S-mode and no U-mode traps.
      //   Quote: "==== medeleg / Address: `0x302` / Unimplemented, as neither U-mode traps
      //   nor S-mode are supported. Access will cause an illegal instruction exception."
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L138-L142
      "delegatable_bits": {
        "len": 64,
        "value": "0x0000_0000_0000_0000"
      }
    },
    "mideleg": {
      // mideleg is likewise unimplemented.
      //   Quote: "==== mideleg / Address: `0x303` / Unimplemented, as neither U-mode traps
      //   nor S-mode are supported."
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L144-L148
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x0000_0000"
      }
    },
    // These settings control whether the specified exceptions
    // cause information to be written into the appropriate
    // `xtval` registers.
    // mtval is hardwired to 0 for every trap cause on Hazard3, so no exception writes it.
    //   Quote: "==== mtval / Address: `0x343` / Hardwired to 0."
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L257-L261
    "xtval_nonzero": {
      "illegal_instruction": false,
      "virtual_instruction": false,
      "load_guest_page_fault": false,
      "samo_guest_page_fault": false,
      "fetch_guest_page_fault": false,
      "software_breakpoint": false,
      "hardware_breakpoint": false,
      "load_address_misaligned": false,
      "load_access_fault": false,
      "load_page_fault": false,
      "samo_address_misaligned": false,
      "samo_access_fault": false,
      "samo_page_fault": false,
      "fetch_address_misaligned": false,
      "fetch_access_fault": false,
      "fetch_page_fault": false,
      "software_check": false,
      "hardware_error": false,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      // The configuration option determines how to handle the reserved behavior `amocas_odd_registers`.
      // "AMOCAS_Fatal"  – raise a Sail exception, stopping execution.
      // "AMOCAS_Illegal" – treat it as an illegal instruction.
      "amocas_odd_register": "AMOCAS_Illegal",
      // The configuration option determines how to handle execution of a floating-point
      // instruction with DYN (dynamic) rounding mode when `fcsr.FRM` contains a
      // reserved value (0b101, 0b110, 0b111).
      // This does not affect the execution of floating-point instructions that have a
      // reserved rounding mode statically encoded in the instruction.
      // "Fcsr_RM_Fatal"  – raise a Sail exception, stopping execution.
      // "Fcsr_RM_Illegal" – treat it as an illegal instruction.
      "fcsr_rm": "Fcsr_RM_Illegal",
      // The configuration option determines how to handle the reserved behavior `pmpcfg_with_R0W1`.
      // "PMP_Fatal"  – raise a Sail exception, stopping execution.
      // "PMP_ClearPermissions" – convert a PMP entry with R=0, W=1 to R=0, W=0, X=0.
      "pmpcfg_write_only": "PMP_ClearPermissions",
      // The configuration option determines how to handle the reserved behavior `xenvcfg.CBIE` with 0b10.
      // "Xenvcfg_Fatal"  – raise a Sail exception, stopping execution.
      // "Xenvcfg_ClearPermissions" – convert CBIE with 0b10 to 0b00.
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      // The configuration option determines how to handle the reserved behavior `xtvec[Mode] >= 2`.
      // "Xtvec_Fatal"  – raise a Sail exception, stopping execution.
      // "Xtvec_Ignore" – use old Mode of xtvec.
      "xtvec_mode": "Xtvec_Ignore",
      // The configuration option determines how to handle the reserved behavior: Odd-numbered registers for RV32Zdinx.
      // "Zdinx_Fatal"  – raise a Sail exception, stopping execution.
      // "Zdinx_Illegal" – treat it as an illegal instruction.
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      // The legal values for the FS and VS fields in this CSR are
      // specified by the two fields below.  Their values can be one
      // of:
      // - "ExtContext_FourState" allows all values {Off, Initial, Clean, Dirty}.
      // - "ExtContext_TwoState" allows {Off, Dirty}, and writes of Initial and Clean get written as Dirty.
      // - "ExtContext_Off" allows only {Off}.  This makes the field read-only zero.
      "fs_legal_states": "ExtContext_Off",
      "vs_legal_states": "ExtContext_Off"
    },
    "privileged_isa_version": "Privileged_ISA_1_12"
  },
  "memory": {
    "physaddr_bits": 32,
    "asidlen": 9,
    "vmidlen": 7,
    "pmp": {
      // PMP_GRAIN = 0 in config_act.vh, i.e. a 4-byte granule, which is also the RTL default
      // and is what makes NA4 available.
      //   Quote: "This is the _G_ parameter in the privileged spec ... If _G_ > 0, `pmcfg.a`
      //   cannot be set to NA4 ... Default value: `0`"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/configuration_and_integration.adoc#L544-L558
      "grain": 0,
      // 16 regions, all dynamically configurable (PMP_HARDWIRED is all-zeroes).
      //   Quote: "Physical memory protection (PMP) with up to 16 regions"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/introduction.adoc#L22
      "count": 16,
      "usable_count": 16,
      // TOR is a build-time option that the CSR chapter describes as unsupported because it
      // documents the default build; config_act.vh sets PMP_MATCH_TOR = 1, so it IS supported
      // here. See the PMP_TOR_SUPPORTED comment in the UDB yaml for both citations.
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/hdl/hazard3_pmp.v#L179
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    // These settings control global support for misaligned access so they are
    // checked before address translation. `misaligned_exceptions` in
    // `regions` is checked after address translation.
    "misaligned": {
      // Hazard3 has no misaligned load/store support. Every bus access is naturally aligned
      // and a misaligned address raises an alignment exception (cause 4 / 6), never an
      // access fault. This applies to ordinary loads and stores, to lr.w/sc.w and to AMOs.
      //   Quote: "All Hazard3 bus accesses are naturally aligned. That is, address modulo
      //   access size is always zero; `HADDR % (1 << HSIZE) == 0`"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/bus_behaviour.adoc#L24
      //   Quote: "|EXTENSION_A && x_unaligned_addr &&  d_memop_is_amo      ? EXCEPT_STORE_ALIGN :
      //   ... x_unaligned_addr &&  x_memop_write ? EXCEPT_STORE_ALIGN :
      //   x_unaligned_addr && !x_memop_write ? EXCEPT_LOAD_ALIGN :"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/hdl/hazard3_core.v#L1117-L1121
      "exceptions": {
        "load_store": { "Some": "AlignmentException" },
        "vector": { "None": null },
        "lrsc": { "Some": "AlignmentException" },
        "amo": { "Some": "AlignmentException" }
      },
      "default_allowed_within_exp": 0,
      "byte_by_byte": false,
      "order_decreasing": false
    },
    // Address to write DTB to (if provided).
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    "regions": [
      // MMIO. This region exists only for the Sail reference build: tests/env/sail_macros.h
      // redefines RVMODEL_MTIME_ADDRESS / RVMODEL_MTIMECMP_ADDRESS / the interrupt macros to
      // Sail's own CLINT and simple-interrupt-generator, so the DUT's 0xC000_0000 IO window
      // never appears in the reference ELF and does not need a region here. Laid out to match
      // config/sail/sail-rv32-max so the reference behaviour is identical.
      {
        "base": {
          "len": 64,
          "value": "0x02000000"
        },
        "size": {
          "len": 64,
          "value": "0x10000000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "None": null },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Main memory: the whole 16 MB the Hazard3 testbench backs at 0x8000_0000. Code, data
      // and the signature all live here, and it must match RAM_ORIGIN/RAM_LENGTH in link.ld.
      // Nothing above 0x80FF_FFFF is backed, which is why 0x9000_0000 is usable as
      // RVMODEL_ACCESS_FAULT_ADDRESS in both the DUT and the reference model.
      //   Quote: "#define MEM_BASE 0x80000000"  /  "#define MEM_SIZE (16 * 1024 * 1024)"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/test/sim/tb_common/include/tb_constants.h#L10-L11
      {
        "base": {
          "len": 64,
          "value": "0x80000000"
        },
        "size": {
          "len": 64,
          "value": "0x01000000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "None": null },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          // Hazard3 implements the full ratified A set (swap/add/and/or/xor/min/max and
          // unsigned variants) but not Zacas, so AMOArithmetic is the right level.
          //   Quote: "|`amoswap.w rd, rs2, (rs1)` | ... |`amomaxu.w rd, rs2, (rs1)` |"
          //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/instruction_timings.adoc#L84-L92
          "atomic_support": "AMOArithmetic",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      }
    ]
  },
  "platform": {
    // mvendorid / marchid / mimpid as the RTL reports them. mvendorid is all-zeroes because
    // config_act.vh sets MVENDORID_VAL to 0 (the manual permits all-zeroes); marchid is the
    // registered open-source architecture ID 27; mimpid encodes release v1.1.1 with the
    // testbench's eco_version of 0xa, giving 0x010101a0 = 16843168.
    //   Quote: "MARCHID: ... rdata = 32'd27;"
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/hdl/hazard3_csr.v#L759-L763
    //   Quote: "| 27:24 | `major` | ... | 23:16 | `minor` | ... | 15:8 | `patch` | ... | 7:4 | `eco` |"
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L50-L56
    "vendorid": 0,
    "archid": 27,
    "impid": 16843168,
    "hartid": 0,
    // Hazard3 has no caches, so this only has to be a legal value; Zicbo* are not claimed.
    "cache_block_size_exp": 6,
    "reservation": {
      // The testbench's AHB5 global monitor compares reservation addresses masked to an
      // aligned 8-byte granule, so the reservation set is 8 bytes (exp 3).
      //   Quote: "#define RESERVATION_ADDR_MASK (0xfffffff8u)"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/test/sim/tb_common/include/tb_constants.h#L12
      "reservation_set_size_exp": 3,
      // An sc.w anywhere inside the reserved 8 bytes succeeds; Hazard3's own local monitor
      // is a single flag with no address, so it never adds an exact-address requirement.
      //   Quote: "mw_local_exclusive_reserved <= bus_dph_exokay_d && !bus_dph_err_d;"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/hdl/hazard3_core.v#L1495
      "require_exact_reservation_addr": false,
      // The testbench clears only *other* masters' reservations on a plain store, and
      // Hazard3's local flag is not cleared by a store at all.
      //   Quote: "// Non-exclusive write still clears others' reservations"
      //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/test/sim/tb_common/tb_memio.cpp#L66
      "invalidate_on_same_hart_store": false
    },
    // All three standard machine interrupts exist: mip.MSIP, mip.MTIP and mip.MEIP are the
    // only writable bits of mip and are driven from core input pins.
    //   Quote: "| 11 | `meip` | ... | 7 | `mtip` | ... | 3 | `msip` |"
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L178-L182
    "interrupts": {
      "machine": {
        "software": { "supported": true },
        "external": { "supported": true },
        "timer": { "supported": true }
      }
    },
    // The CLINT and the simple interrupt generator belong to the Sail reference model only.
    // The Hazard3 testbench's own timer and interrupt-injection registers live at
    // 0xC000_0100 / 0xC000_0010 / 0xC000_0020 and are named in rvmodel_macros.h;
    // tests/env/sail_macros.h replaces them with these addresses for the reference build,
    // so the two never have to agree. Laid out to match config/sail/sail-rv32-max.
    "clint": {
      "supported": true,
      "base": 33554432,
      "size": 786432
    },
    "simple_interrupt_generator": {
      "supported": true,
      "base": 201326592
    },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    // WFI stalls until an interrupt is pending; it is not a no-op.
    //   Quote: "Privileged instructions `ecall`, `ebreak`, `mret` and `wfi`"
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/introduction.adoc#L21
    "wfi_is_nop": false,
    // WFI is legal in U-mode unless mstatus.TW is set, which is the standard behaviour.
    //   Quote: "| 21 | `tw` | Timeout wait. Only present if U-mode is supported. When 1,
    //   attempting to execute a WFI instruction in U-mode will instantly cause an illegal
    //   instruction exception."
    //   https://github.com/Wren6991/Hazard3/blob/8af992930f71a69b0e06c38734c1094f41a05ca0/doc/sections/csr.adoc#L124
    "wfi_available_to_user_mode": true,
    "max_time_to_wait": 1000
  },
  "extensions": {
    "M": {
      "supported": true
    },
    "A": {
      "supported": true
    },
    "F": {
      "supported": false,
      "fflags_dirty_policy": "Fflags_Dirty_Precise"
    },
    "D": {
      "supported": false
    },
    "V": {
      // `support_level` must be one of the below strings:
      // . "Disabled" for no vector extension support
      // . "Integer" for Zve*x support
      // . "Float_single" for Zve*f support
      // . "Float_double" for Zve*d support
      // . "Full" for the full V extension
      // Note that `support_level` requires compatible
      // values for `vlen_exp` and `elen_exp` below.
      // For e.g. Zve32x and Zve32f require `elen_exp` >= 5,
      // Zve64x, Zve64f, and Zve64d require `elen_exp` >= 6,
      // and V requires `elen_exp` >= 6 and `vlen_exp` >= 7.
      "support_level": "Disabled",
      "vlen_exp": 7,
      "elen_exp": 6,
      "reserved_behavior": {
        // This determines how to handle attempts by vsetvli, vsetivli,
        // and vsetvl to set an unsupported or reserved vtype.
        // "IllegalVtype_SetVill" - set vtype.vill, set vl to zero, clear vstart, and write rd.
        // "IllegalVtype_Illegal" - treat it as an illegal instruction.
        // "IllegalVtype_Fatal"   - raise a Sail exception, stopping execution.
        "illegal_vtype": "IllegalVtype_SetVill",
        // This determines how to handle an out-of-bounds vstart (vstart >= VLMAX), which the
        // vector spec marks reserved and recommends, but does not require, trapping.
        // "Vstart_Illegal" - raise an illegal instruction exception.
        // "Vstart_Ignore"  - treat as a no-op, the instruction writes nothing.
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      // The maximum index EEW for indexed vector addressing mode, as
      // a power of 2.  This must be at least 3 but must not exceed
      // the supported ELEN.
      "max_index_eew_exp": 5,
      "vstart": {
        // The vector specification permits implementations to raise an
        // illegal instruction exception when `vstart` is non-zero for
        // instructions that cannot produce such a `vstart` value through
        // normal execution.
        "zero_required": {
          // Whether vector arithmetic instructions raise an illegal instruction
          // exception when `vstart` is non-zero. This also governs instructions
          // from the Zvbb, Zvbc, Zvabd, Zvfbfmin, and Zvfbfwma extensions.
          "arith": true,
          // Whether the vector scalar move instructions (vmv.x.s, vmv.s.x,
