covergroup Zve32x_vnsrl_wx_sew8_cg with function sample(ins_t ins);
    option.per_instance = 0;
    cp_asm_count : coverpoint ins.ins_str == "vnsrl.wx"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_shift_wx_sew8
    //////////////////////////////////////////////////////////////////////////////////

    // Custom coverpoints for Vector shift and clip instructions with wx operands

    // ensures vd updates
    // cross vtype_prev_vill_clear, vstart_zero, vl_nonzero, no_trap;
