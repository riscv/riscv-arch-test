`endif
function void exceptionsv_sample(int hart, int issue, ins_t ins);
    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 0 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (traceDataQ[hart][issue][0].inst_name)
`ifdef ZVE32X_SUPPORTED
        "vaadd.vv"     : begin
            ExceptionsVZve32x_vaadd_vv_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vaadd.vx"     : begin
            ExceptionsVZve32x_vaadd_vx_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vaaddu.vv"     : begin
            ExceptionsVZve32x_vaaddu_vv_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vaaddu.vx"     : begin
            ExceptionsVZve32x_vaaddu_vx_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vadc.vim"     : begin
            ExceptionsVZve32x_vadc_vim_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vadc.vvm"     : begin
            ExceptionsVZve32x_vadc_vvm_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vadc.vxm"     : begin
            ExceptionsVZve32x_vadc_vxm_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vadd.vi"     : begin
            ExceptionsVZve32x_vadd_vi_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vadd.vv"     : begin
            ExceptionsVZve32x_vadd_vv_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vadd.vx"     : begin
            ExceptionsVZve32x_vadd_vx_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vand.vi"     : begin
            ExceptionsVZve32x_vand_vi_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vand.vv"     : begin
            ExceptionsVZve32x_vand_vv_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vand.vx"     : begin
            ExceptionsVZve32x_vand_vx_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vasub.vv"     : begin
            ExceptionsVZve32x_vasub_vv_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vasub.vx"     : begin
            ExceptionsVZve32x_vasub_vx_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vasubu.vv"     : begin
            ExceptionsVZve32x_vasubu_vv_sew8_cg.sample(ins);
        end
`endif
`ifdef ZVE32X_SUPPORTED
        "vasubu.vx"     : begin
            ExceptionsVZve32x_vasubu_vx_sew8_cg.sample(ins);
        end
