    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs1 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs1 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers
    }

    //// end cmp_vd_vs1////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
