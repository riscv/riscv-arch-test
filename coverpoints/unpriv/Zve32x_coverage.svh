                bins two = {2};
            }

            ffLS_mask_enabled: coverpoint ins.current.insn[25] {
                bins masked = {1'b0};
            }

            ffLS_vl_ge2: coverpoint (get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl")) {
                bins ge2 = {[2:$]};
            }

