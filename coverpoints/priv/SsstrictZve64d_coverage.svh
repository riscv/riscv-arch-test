// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // vfmv.f.s (funct6=010000, funct3=001) and vfmv.s.f (funct6=010000, funct3=101) with vm=0 are reserved
    vfmv_fs_sf_funct6: coverpoint ins.current.insn[31:26] {
        bins vfmv = {6'b010000};
    }

