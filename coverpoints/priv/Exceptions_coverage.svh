    vstart_vals: coverpoint vstart_check(ins.hart, ins.issue) {
        bins vstart_one     = {vstart_one};
        bins vstart_vlmaxm1 = {vstart_vlmaxm1};
        bins vstart_vlmaxd2 = {vstart_vlmaxd2};
        bins vstart_legal   = {vstart_legal};   // random vstart
    }

    vl_eq_vlmax: coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) == get_vtype_vlmax(ins.hart, ins.issue, `SAMPLE_BEFORE)
    {
        bins true = { 1 };
    }

    cp_vstart: cross vstart_vals, vl_eq_vlmax;

    //// end cp_vstart////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vstart_gt_vl
    //////////////////////////////////////////////////////////////////////////////////

    cp_vstart_gt_vl: coverpoint (get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) >  get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) &
                                 `UDB_MXLEN'(get_vtype_vlmax(ins.hart, ins.issue, `SAMPLE_BEFORE)) > get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART)){
        bins true = {1};
    }

    //// end cp_vstart_gt_vl////////////////////////////////////////////////

endgroup
// ---------------------
covergroup ExceptionsZve64f_vfwcvt_x_f_v_sew32_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cp_mstatus_fs_off
    // A vector floating-point instruction must raise an illegal-instruction trap
    // when mstatus.FS == Off (FP extension disabled). The cross pins mstatus.VS to
    // a non-Off value so the trap can only be attributed to FS being Off (not VS).
    //////////////////////////////////////////////////////////////////////////////////

    mstatus_fs_off : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "fs") {
        bins inactive = {0};
    }

    mstatus_vs_active_for_fs_off : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "vs") {
        bins active = {[1:3]};
    }

    cp_mstatus_fs_off : cross mstatus_fs_off, mstatus_vs_active_for_fs_off;

    //// end cp_mstatus_fs_off////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_mstatus_vs_off
    // A vector floating-point instruction must raise an illegal-instruction trap
    // when mstatus.VS == Off (V extension disabled). The cross pins mstatus.FS to
    // a non-Off value so the trap can only be attributed to VS being Off (not FS).
    //////////////////////////////////////////////////////////////////////////////////

    mstatus_vs_off : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "vs") {
        bins inactive = {0};
    }

    mstatus_fs_active_for_vs_off : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "fs") {
        bins active = {[1:3]};
    }

    cp_mstatus_vs_off : cross mstatus_vs_off, mstatus_fs_active_for_vs_off;

    //// end cp_mstatus_vs_off////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vectorfp_mstatus_fs_state
    // Sample the vector-FP instruction under each non-Off mstatus.FS starting
    // state (Initial=1, Clean=2, Dirty=3) with mstatus.VS != Off. We cannot
    // observe the FS state transition directly (legal impls may hard-wire FS to
    // Dirty), so this coverpoint only ensures the test exercises every starting
    // FS state. Combined with signature-based cross-model checking, this catches
    // transitioning-model bugs.
    //////////////////////////////////////////////////////////////////////////////////

    mstatus_fs_state : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "fs") {
        `ifdef UDB_MSTATUS_FS_LEGAL_VALUES_1
            bins fs_initial = {1};
        `endif
        `ifdef UDB_MSTATUS_FS_LEGAL_VALUES_2
            bins fs_clean   = {2};
        `endif
        bins fs_dirty   = {3};
    }

    mstatus_vs_active_for_fs_state : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "vs") {
        bins active = {[1:3]};
    }

    cp_vectorfp_mstatus_fs_state : cross mstatus_fs_state, mstatus_vs_active_for_fs_state;

    //// end cp_vectorfp_mstatus_fs_state////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vill
    //////////////////////////////////////////////////////////////////////////////////

    cp_vill: coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vill") {
        bins one  = {1};
    }

    //// end cp_vill////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vstart
    //////////////////////////////////////////////////////////////////////////////////

    vstart_vals: coverpoint vstart_check(ins.hart, ins.issue) {
        bins vstart_one     = {vstart_one};
        bins vstart_vlmaxm1 = {vstart_vlmaxm1};
        bins vstart_vlmaxd2 = {vstart_vlmaxd2};
        bins vstart_legal   = {vstart_legal};   // random vstart
    }

    vl_eq_vlmax: coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) == get_vtype_vlmax(ins.hart, ins.issue, `SAMPLE_BEFORE)
    {
        bins true = { 1 };
    }

    cp_vstart: cross vstart_vals, vl_eq_vlmax;

    //// end cp_vstart////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vstart_gt_vl
    //////////////////////////////////////////////////////////////////////////////////

    cp_vstart_gt_vl: coverpoint (get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) >  get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) &
                                 `UDB_MXLEN'(get_vtype_vlmax(ins.hart, ins.issue, `SAMPLE_BEFORE)) > get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART)){
        bins true = {1};
    }

    //// end cp_vstart_gt_vl////////////////////////////////////////////////

endgroup
