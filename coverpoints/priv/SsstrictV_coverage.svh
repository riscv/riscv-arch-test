// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_vfp_frm_reserved
// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // Vector FP instruction with invalid frm (reserved rounding modes 5, 6, 7)

    frm_invalid: coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "frm", "frm") {
