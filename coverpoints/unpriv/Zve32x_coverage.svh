covergroup Zve32x_vsbc_vvm_sew8_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs1_nv0
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs1_nv0 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs1 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers, vd not v0
        ignore_bins v0 = {v0};
    }

    //// end cmp_vd_vs1_nv0////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs1_vs2_nv0
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs1_vs2_nv0 : coverpoint ins.get_vr_reg(ins.current.vd) iff (ins.current.vd == ins.current.vs1 & ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers, vd not v0
        ignore_bins v0 = {v0};
    }

    //// end cmp_vd_vs1_vs2_nv0////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs2_nv0
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs2_nv0 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers, vd not v0
        ignore_bins v0 = {v0};
    }

    //// end cmp_vd_vs2_nv0////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vs1_vs2_nv0
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vs1_vs2_nv0 : coverpoint ins.get_vr_reg(ins.current.vs1)  iff (ins.current.vs1 == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers, vs1 not v0
        ignore_bins v0 = {v0};
    }

    //// end cmp_vs1_vs2_nv0////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vsbc.vvm"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_nv0
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_nv0 : coverpoint ins.get_vr_reg(ins.current.vd) iff (ins.trap == 0) {
        // VD register assignment (excluding v0)
        ignore_bins v0 = {v0};
    }

        //// end cp_vd_nv0////////////////////////////////////////////////

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl") {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1_edges
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1_edges : coverpoint vs_edges_check(ins.hart, ins.issue, ins.current.vs1_val, "1")  iff (ins.trap == 0 )  {
        // Edges values of vs1, assuming vl = 1
        bins zero       = {vs_zero      };   //  = {(`SEW){1'b0}},
        bins one        = {vs_one       };   //  = {(`SEW-1){1'b0}, {1'b1}},
        bins two        = {vs_two       };   //  = {(`SEW-2){1'b0}, {2'b10}},
        bins min        = {vs_min       };   //  = {{1'b1}, (`SEW-1){1'b0}},
        bins minp1      = {vs_minp1     };   //  = {{1'b1}, (`SEW-2){1'b0}, {1'b1}},
        bins max        = {vs_max       };   //  = {{1'b0}, (`SEW-1){1'b1}},
        bins maxm1      = {vs_maxm1     };   //  = {{1'b0}, (`SEW-2){1'b1}, {1'b0}},
        bins ones       = {vs_ones      };   //  = {(`SEW){1'b1}},
        bins onesm1     = {vs_onesm1    };   //  = {(`SEW-1){1'b1}, {1'b0}},
        bins walkodd    = {vs_walkodd   };   //  = {(`SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(SEW){random}}
    }

    //// end cp_vs1_edges////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1_nv0
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1_nv0 : coverpoint ins.get_vr_reg(ins.current.vs1) iff (ins.trap == 0) {
        // VS1 register assignment (excluding v0)
        ignore_bins v0 = {v0};
    }

    //// end cp_vs1_nv0////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
