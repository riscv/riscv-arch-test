{
  "ignorePatterns": [
    {
      "pattern": "^https://lists.riscv.org/g/sig-arch-test",
      "reason": "Random CI False Negative"
    },
    {
      "pattern": "^https://docs\\.openhwfoundation\\.org/",
      "reason": "Checked by .markdown-link-check-openhw.config, which accepts HTTP 429"
    }
  ],
  "timeout": "30s",
  "retryOn429": true,
  "retryCount": 5,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 502, 503, 504]
}
