        // Compare assignments of all 32 registers
    }

    //// eend cmp_vs1_vs2////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vmandn.mm"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_vmask_write_lmulge1
    //////////////////////////////////////////////////////////////////////////////////

