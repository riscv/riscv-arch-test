`endif
function void zilx_sample(int hart, int issue, ins_t ins);

    case (traceDataQ[hart][issue][0].inst_name)
        "lxh"     : begin
            Zilx_lxh_cg.sample(ins);
        end
        "lxhu"     : begin
            Zilx_lxhu_cg.sample(ins);
        end
        "lxsb"     : begin
            Zilx_lxsb_cg.sample(ins);
        end
        "lxsbu"     : begin
            Zilx_lxsbu_cg.sample(ins);
        end
        "lxsh"     : begin
            Zilx_lxsh_cg.sample(ins);
        end
        "lxshu"     : begin
            Zilx_lxshu_cg.sample(ins);
        end
        "lxsw"     : begin
            Zilx_lxsw_cg.sample(ins);
        end
        "lxw"     : begin
            Zilx_lxw_cg.sample(ins);
        end
`ifdef UDB_MXLEN_64
        "lxd"     : begin
            Zilx_lxd_cg.sample(ins);
        end
        "lxsd"     : begin
            Zilx_lxsd_cg.sample(ins);
        end
        "lxsuwb"     : begin
            Zilx_lxsuwb_cg.sample(ins);
        end
        "lxsuwbu"     : begin
            Zilx_lxsuwbu_cg.sample(ins);
        end
        "lxsuwd"     : begin
            Zilx_lxsuwd_cg.sample(ins);
        end
        "lxsuwh"     : begin
            Zilx_lxsuwh_cg.sample(ins);
        end
        "lxsuwhu"     : begin
            Zilx_lxsuwhu_cg.sample(ins);
        end
        "lxsuww"     : begin
            Zilx_lxsuww_cg.sample(ins);
        end
        "lxsuwwu"     : begin
            Zilx_lxsuwwu_cg.sample(ins);
        end
        "lxswu"     : begin
            Zilx_lxswu_cg.sample(ins);
        end
        "lxwu"     : begin
            Zilx_lxwu_cg.sample(ins);
        end
`endif
    endcase
endfunction
