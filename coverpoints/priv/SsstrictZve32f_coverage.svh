        end
        "vfrsqrt7.v"     : begin
            SsstrictZve32f_vfrsqrt7_v_cg.sample(ins);
        end
        "vfrsub.vf"     : begin
            SsstrictZve32f_vfrsub_vf_cg.sample(ins);
        end
        "vfsgnj.vf"     : begin
            SsstrictZve32f_vfsgnj_vf_cg.sample(ins);
        end
        "vfsgnj.vv"     : begin
            SsstrictZve32f_vfsgnj_vv_cg.sample(ins);
        end
        "vfsgnjn.vf"     : begin
            SsstrictZve32f_vfsgnjn_vf_cg.sample(ins);
