covergroup SsstrictV_vloxseg7ei64_v_sew32_cg with function sample(ins_t ins);
    option.per_instance = 0;
    `include "general/RISCV_coverage_ssstrictv_helpers.svh"
// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_ls_eew_lt_sewmin
