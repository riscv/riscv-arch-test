    cp_vd_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
