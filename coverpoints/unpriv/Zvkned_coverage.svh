    cp_vd_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vd_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vd_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vd_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vd_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vd_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vd_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vd_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vd_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vd_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vd_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vd_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4_subbytes_0  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_0   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_1  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_1   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_2  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_2   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_3  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_3   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_4  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_4   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_5  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_5   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_6  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_6   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_7  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_7   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_8  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_8   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_9  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_9   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_10 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_10  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_11 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_11  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_12 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_12  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_13 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_13  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_14 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_14  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_15 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_15  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaesdm_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers; with VLEN=64 only even registers are valid (LMUL=2), and VLEN=32 only multiple of 4 are valid (LMUL=4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cmp_vd_vs2_egs4////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vaesdm.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4_byte_0 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[7:0])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 0);
    }

    cp_vd_edges_egs4_byte_1 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[15:8])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 1);
    }

    cp_vd_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
    }

    cp_vd_edges_egs4_byte_3 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[31:24])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 3);
    }

    cp_vd_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vd_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vd_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vd_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vd_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vd_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vd_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vd_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vd_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vd_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vd_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vd_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4_subbytes_0  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_0   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_1  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_1   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_2  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_2   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_3  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_3   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_4  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_4   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_5  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_5   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_6  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_6   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_7  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_7   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_8  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_8   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_9  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_9   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_10 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_10  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_11 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_11  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_12 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_12  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_13 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_13  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_14 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_14  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_15 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_15  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaesef_vs_cg with function sample(ins_t ins);
    option.per_instance = 0;
    cp_asm_count : coverpoint ins.ins_str == "vaesef.vs"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4_byte_0 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[7:0])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 0);
    }

    cp_vd_edges_egs4_byte_1 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[15:8])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 1);
    }

    cp_vd_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
    }

    cp_vd_edges_egs4_byte_3 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[31:24])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 3);
    }

    cp_vd_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vd_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vd_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vd_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vd_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vd_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vd_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vd_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vd_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vd_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vd_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vd_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4_subbytes_0  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_0   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_1  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_1   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_2  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_2   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_3  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_3   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_4  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_4   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_5  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_5   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_6  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_6   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_7  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_7   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_8  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_8   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_9  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_9   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_10 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_10  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_11 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_11  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_12 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_12  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_13 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_13  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_14 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_14  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_15 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_15  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaesef_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers; with VLEN=64 only even registers are valid (LMUL=2), and VLEN=32 only multiple of 4 are valid (LMUL=4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cmp_vd_vs2_egs4////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vaesef.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4_byte_0 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[7:0])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 0);
    }

    cp_vd_edges_egs4_byte_1 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[15:8])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 1);
    }

    cp_vd_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
    }

    cp_vd_edges_egs4_byte_3 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[31:24])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 3);
    }

    cp_vd_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vd_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vd_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vd_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vd_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vd_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vd_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vd_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vd_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vd_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vd_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vd_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4_subbytes_0  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_0   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_1  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_1   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_2  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_2   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_3  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_3   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_4  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_4   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_5  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_5   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_6  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_6   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_7  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_7   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_8  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_8   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_9  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_9   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_10 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_10  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_11 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_11  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_12 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_12  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_13 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_13  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_14 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_14  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_15 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_15  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaesem_vs_cg with function sample(ins_t ins);
    option.per_instance = 0;
    cp_asm_count : coverpoint ins.ins_str == "vaesem.vs"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4_byte_0 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[7:0])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 0);
    }

    cp_vd_edges_egs4_byte_1 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[15:8])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 1);
    }

    cp_vd_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
    }

    cp_vd_edges_egs4_byte_3 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[31:24])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 3);
    }

    cp_vd_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vd_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vd_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vd_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vd_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vd_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vd_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vd_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vd_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vd_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vd_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vd_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4_subbytes_0  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_0   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_1  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_1   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_2  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_2   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_3  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_3   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_4  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_4   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_5  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_5   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_6  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_6   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_7  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_7   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_8  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_8   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_9  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_9   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_10 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_10  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_11 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_11  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_12 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_12  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_13 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_13  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_14 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_14  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_15 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_15  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaesem_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers; with VLEN=64 only even registers are valid (LMUL=2), and VLEN=32 only multiple of 4 are valid (LMUL=4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cmp_vd_vs2_egs4////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vaesem.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4_byte_0 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[7:0])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 0);
    }

    cp_vd_edges_egs4_byte_1 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[15:8])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 1);
    }

    cp_vd_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
    }

    cp_vd_edges_egs4_byte_3 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[31:24])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 3);
    }

    cp_vd_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vd_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vd_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vd_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vd_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vd_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vd_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vd_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vd_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vd_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vd_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vd_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vd)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4_subbytes_0  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_0   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_1  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_1   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_2  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_2   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_3  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_3   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_4  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_4   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_5  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_5   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_6  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_6   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_7  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_7   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_8  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_8   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_9  : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_9   iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_10 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_10  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_11 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_11  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_12 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_12  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_13 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_13  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_14 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_14  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_15 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_byte_15  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaeskf1_vi_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers; with VLEN=64 only even registers are valid (LMUL=2), and VLEN=32 only multiple of 4 are valid (LMUL=4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cmp_vd_vs2_egs4////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vaeskf1.vi"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    cp_imm_5bit_u : coverpoint unsigned'(ins.current.imm)  iff (ins.trap == 0 )  {
        bins uimm[] = {[0:31]}; // 5 bit unsigned immediates for vector instructions
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    cp_vl_0_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl") {
        bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4_byte_0 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[7:0])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 0);
    }

    cp_vs2_edges_egs4_byte_1 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[15:8])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 1);
    }

    cp_vs2_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
    }

    cp_vs2_edges_egs4_byte_3 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[31:24])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 3);
    }

    cp_vs2_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vs2_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vs2_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vs2_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vs2_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vs2_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vs2_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vs2_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vs2_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vs2_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vs2_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vs2_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vs2_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaeskf2_vi_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers; with VLEN=64 only even registers are valid (LMUL=2), and VLEN=32 only multiple of 4 are valid (LMUL=4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cmp_vd_vs2_egs4////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vaeskf2.vi"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    cp_imm_5bit_u : coverpoint unsigned'(ins.current.imm)  iff (ins.trap == 0 )  {
        bins uimm[] = {[0:31]}; // 5 bit unsigned immediates for vector instructions
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vd))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vd (EGS=4), assuming vl = 1
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    cp_vl_0_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl") {
        bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4_subbytes
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4_byte_0 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[7:0])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 0);
    }

    cp_vs2_edges_egs4_byte_1 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[15:8])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 1);
    }

    cp_vs2_edges_egs4_byte_2 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[23:16])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 2);
    }

    cp_vs2_edges_egs4_byte_3 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[31:24])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 3);
    }

    cp_vs2_edges_egs4_byte_4 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[39:32])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 4);
    }

    cp_vs2_edges_egs4_byte_5 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[47:40])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 5);
    }

    cp_vs2_edges_egs4_byte_6 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[55:48])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 6);
    }

    cp_vs2_edges_egs4_byte_7 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[63:56])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 7);
    }

    cp_vs2_edges_egs4_byte_8 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[71:64])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 8);
    }

    cp_vs2_edges_egs4_byte_9 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[79:72])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 9);
    }

    cp_vs2_edges_egs4_byte_10 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[87:80])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 10);
    }

    cp_vs2_edges_egs4_byte_11 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[95:88])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 11);
    }

    cp_vs2_edges_egs4_byte_12 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[103:96])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 12);
    }

    cp_vs2_edges_egs4_byte_13 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[111:104])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 13);
    }

    cp_vs2_edges_egs4_byte_14 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[119:112])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 14);
    }

    cp_vs2_edges_egs4_byte_15 : coverpoint (ins.get_vr_val_lmul4(ins.current.vs2)[127:120])
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 16 == 15);
    }

    //// end cp_vs2_edges_egs4_subbytes ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes_vs2
    //////////////////////////////////////////////////////////////////////////////////

    // Cross coverage of VS2 subbyte edges and VD edges (EGS=4) — VS2 is the subbyte source (e.g. vaeskf2.vi)
    cr_vs2_vd_edges_egs4_subbytes_vs2_0  : cross cp_vs2_edges_egs4_byte_0,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_1  : cross cp_vs2_edges_egs4_byte_1,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_2  : cross cp_vs2_edges_egs4_byte_2,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_3  : cross cp_vs2_edges_egs4_byte_3,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_4  : cross cp_vs2_edges_egs4_byte_4,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_5  : cross cp_vs2_edges_egs4_byte_5,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_6  : cross cp_vs2_edges_egs4_byte_6,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_7  : cross cp_vs2_edges_egs4_byte_7,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_8  : cross cp_vs2_edges_egs4_byte_8,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_9  : cross cp_vs2_edges_egs4_byte_9,  cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_10 : cross cp_vs2_edges_egs4_byte_10, cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_11 : cross cp_vs2_edges_egs4_byte_11, cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_12 : cross cp_vs2_edges_egs4_byte_12, cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_13 : cross cp_vs2_edges_egs4_byte_13, cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_14 : cross cp_vs2_edges_egs4_byte_14, cp_vd_edges_egs4  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_vs2_15 : cross cp_vs2_edges_egs4_byte_15, cp_vd_edges_egs4  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes_vs2 ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvkned_vaesz_vs_cg with function sample(ins_t ins);
    option.per_instance = 0;
    cp_asm_count : coverpoint ins.ins_str == "vaesz.vs"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vd))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vd (EGS=4), assuming vl = 1
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions (EGS*SEW = 128 bits per group)
        // LMUL=8/4/2: always valid since VLEN=64 (minimum) satisfies LMUL*VLEN >= 128 bits
        bins eight  = {3};
        bins four   = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two    = {1};
        `endif
        // Smaller LMULs require larger VLEN so that >=2 element groups are possible
        `ifdef ZVL128B_SUPPORTED
            bins one    = {0};   // LMUL=1: needs VLEN>=256 for >=2 element groups
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef LMULf2_SUPPORTED
                bins half    = {7};   // LMUL=1/2: needs VLEN>=512
            `endif
        `endif
    }

    cp_csr_vl_edges_egs4 : coverpoint vl_check(ins.hart, ins.issue, 4)  iff (ins.trap == 0 )  {
        // Edge values of VL (vector length)
        bins vl_four     = {vl_one      };
        bins vlmax      = {vl_vlmax     };
        bins vl_legal      = {vl_legal     };
    }

    cr_vl_lmul_egs4_sew32 : cross cp_csr_vtype_lmul_egs4_sew32, cp_csr_vl_edges_egs4  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage of LMUL and VL edges for EGS=4 instructions at SEW=32
        `ifdef ZVL256B_SUPPORTED
            `ifndef ZVL512B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL1024B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmulf2 = binsof(cp_csr_vtype_lmul_egs4_sew32.half) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            `ifndef ZVL256B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL512B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul1 = binsof(cp_csr_vtype_lmul_egs4_sew32.one) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL64B_SUPPORTED
            `ifndef ZVL128B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL256B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul2 = binsof(cp_csr_vtype_lmul_egs4_sew32.two) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
        `ifdef ZVL32B_SUPPORTED
            `ifndef ZVL64B_SUPPORTED
                // In this case, there is exactly one valid vl, vl_legal is covered by the next ifndef
                ignore_bins vlfour_eq_vlmax_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vlmax);
            `endif
            `ifndef ZVL128B_SUPPORTED
                // In this case, there are two valid vls, so vl_legal is not possible to hit
                ignore_bins impossible_vl_legal_lmul4 = binsof(cp_csr_vtype_lmul_egs4_sew32.four) && binsof(cp_csr_vl_edges_egs4.vl_legal);
            `endif
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VD edges (EGS=4)
    }

    //// end cr_vs2_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
function void zvkned_sample(int hart, int issue, ins_t ins);
    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (traceDataQ[hart][issue][0].inst_name)
        "vaesdf.vs"     : begin
            Zvkned_vaesdf_vs_cg.sample(ins);
        end
        "vaesdf.vv"     : begin
            Zvkned_vaesdf_vv_cg.sample(ins);
        end
        "vaesdm.vs"     : begin
            Zvkned_vaesdm_vs_cg.sample(ins);
        end
        "vaesdm.vv"     : begin
            Zvkned_vaesdm_vv_cg.sample(ins);
        end
        "vaesef.vs"     : begin
            Zvkned_vaesef_vs_cg.sample(ins);
        end
        "vaesef.vv"     : begin
            Zvkned_vaesef_vv_cg.sample(ins);
        end
        "vaesem.vs"     : begin
            Zvkned_vaesem_vs_cg.sample(ins);
        end
        "vaesem.vv"     : begin
            Zvkned_vaesem_vv_cg.sample(ins);
        end
        "vaeskf1.vi"     : begin
            Zvkned_vaeskf1_vi_cg.sample(ins);
        end
        "vaeskf2.vi"     : begin
            Zvkned_vaeskf2_vi_cg.sample(ins);
        end
        "vaesz.vs"     : begin
            Zvkned_vaesz_vs_cg.sample(ins);
        end
        endcase
    end
endfunction
