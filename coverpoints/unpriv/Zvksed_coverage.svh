            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cmp_vd_vs2_egs4////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vsm4r.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4_subbytes_sm
    //////////////////////////////////////////////////////////////////////////////////

    // First sm4_subword call in vsm4r: B = x1 ^ x2 ^ x3 ^ rk0
    //   x0..x3 = vd words 0..3 = vd[31:0], vd[63:32], vd[95:64], vd[127:96]
    //   rk0..rk3 = vs2 words 0..3; rk0 = vs2[31:0]
    cp_vd_edges_egs4_sm_byte_0 : coverpoint (shangmi_round_subbyte(ins.get_vr_val_lmul4(ins.current.vd)[127:0], ins.get_vr_val_lmul4(ins.current.vs2)[127:0], 0))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 4 == 0);
    }

    cp_vd_edges_egs4_sm_byte_1 : coverpoint (shangmi_round_subbyte(ins.get_vr_val_lmul4(ins.current.vd)[127:0], ins.get_vr_val_lmul4(ins.current.vs2)[127:0], 1))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 4 == 1);
    }

    cp_vd_edges_egs4_sm_byte_2 : coverpoint (shangmi_round_subbyte(ins.get_vr_val_lmul4(ins.current.vd)[127:0], ins.get_vr_val_lmul4(ins.current.vs2)[127:0], 2))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 4 == 2);
    }

    cp_vd_edges_egs4_sm_byte_3 : coverpoint (shangmi_round_subbyte(ins.get_vr_val_lmul4(ins.current.vd)[127:0], ins.get_vr_val_lmul4(ins.current.vs2)[127:0], 3))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        bins subbyte[] = {[0:255]} with (item % 4 == 3);
    }

    //// end cp_vd_edges_egs4_subbytes_sm ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vd_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=32: with VLEN=64 LMUL=2 is required, so odd registers are illegal, with VLEN=32, LMUL=4 is required so all registers must be a multiple of 4)
        `ifndef ZVL128B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10  = {v10};
            ignore_bins v14  = {v14};
            ignore_bins v18  = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif
    }

    //// end cp_vs2_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew32 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul")  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 2) {
        // LMUL values for EGS=4, SEW=32 instructions: LMUL * VLEN must be at least EGW = 128
        bins eight = {3};
        bins four = {2};
        `ifdef ZVL64B_SUPPORTED
            bins two = {1};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins one = {0};
        `endif
        `ifdef ZVL256B_SUPPORTED
            `ifdef UDB_ELEN_64
                bins half = {7};
            `endif
        `endif
    }

    cr_vl_lmul_egs4_sew32 : coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul")[2:0],
                                         3'(vl_check(ins.hart, ins.issue, 4))}  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 2)  {
        // LMUL crossed with vl = EGS, VLMAX and a value in between for EGS=4 instructions at SEW=32.
        // LMUL * VLEN must be at least EGW = 128, and VLMAX = VLEN * LMUL / SEW must hold at least two
        // element groups for a distinct VLMAX and four for a value in between.
        `ifdef UDB_ELEN_64
            `ifdef ZVL256B_SUPPORTED
                bins half_one = {6'b111_001};
            `endif
            `ifdef ZVL512B_SUPPORTED
                bins half_vlmax = {6'b111_010};
            `endif
            `ifdef ZVL1024B_SUPPORTED
                bins half_legal = {6'b111_011};
            `endif
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins one_one = {6'b000_001};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins one_vlmax = {6'b000_010};
        `endif
        `ifdef ZVL512B_SUPPORTED
            bins one_legal = {6'b000_011};
        `endif
        `ifdef ZVL64B_SUPPORTED
            bins two_one = {6'b001_001};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins two_vlmax = {6'b001_010};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins two_legal = {6'b001_011};
        `endif
        bins four_one = {6'b010_001};
        `ifdef ZVL64B_SUPPORTED
            bins four_vlmax = {6'b010_010};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins four_legal = {6'b010_011};
        `endif
        bins eight_one = {6'b011_001};
        bins eight_vlmax = {6'b011_010};
        `ifdef ZVL64B_SUPPORTED
            bins eight_legal = {6'b011_011};
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4_subbytes_sm
    //////////////////////////////////////////////////////////////////////////////////

    // Cross coverage of VS2 edges and VD SM4 subbyte edges (EGS=4, B = x1^x2^x3^rk0)
    cr_vs2_vd_edges_egs4_subbytes_sm_0 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_sm_byte_0  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_sm_1 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_sm_byte_1  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_sm_2 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_sm_byte_2  iff (ins.trap == 0 )  {}
    cr_vs2_vd_edges_egs4_subbytes_sm_3 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4_sm_byte_3  iff (ins.trap == 0 )  {}

    //// end cr_vs2_vd_edges_egs4_subbytes_sm ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vta")[0]  iff (ins.trap == 0)  {}

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vma")[0]  iff (ins.trap == 0)  {}

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
function void zvksed_sample(int hart, int issue, ins_t ins);
    string inst_name = traceDataQ[hart][issue][0].inst_name;

    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_field(hart, issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 2 ||
        get_csr_field(hart, issue, `SAMPLE_BEFORE, CSR_VTYPE, "vill") == 1) begin
        case (inst_name)
            "vsm4k.vi"     : begin
                Zvksed_vsm4k_vi_cg.sample(ins);
            end
            "vsm4r.vs"     : begin
                Zvksed_vsm4r_vs_cg.sample(ins);
            end
            "vsm4r.vv"     : begin
                Zvksed_vsm4r_vv_cg.sample(ins);
            end
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
endfunction
