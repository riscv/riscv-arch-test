{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.15/sail_riscv_config_schema.json",
  "base": {
    "xlen": 32,
    "E": false,
    // Whether a `mhpmcounter` increments if the event it is counting
    // was generated during a write to its corresponding `mhpmevent`
    // CSR (which could change the monitored event).
    "hpmcounter_increments_in_self_hpmevent_write": false,
    // The precision of the HPM counter, upto 64 bits.
    "hpmcounter_width_bits": 64,
    // The width of the `mhpmevent` CSRs, upto 64 bits, if Sscofpmf is
    // not supported.  On RV32 without Sscofpmf, this can be upto 32,
    // since the `mhpmeventh` CSRs are not accessible.
    // If Sscofpmf is supported, the `mhpmevent` CSRs are always 64
    // bits; this value then defines the number, upto 56, of the lowest
    // bits of the CSRs that are used as the event selector.
    "hpmevent_width_bits": 32,
    "mcountinhibit": {
      // Whether the `mcountinhibit` CSR is implemented.
      "supported": true,
      // This bits in this value control whether the corresponding
      // bits of the CSR are writable.  Note that bit 1 cannot be written
      // to as it is read-only zero.
      "writable_bits": { "len": 32, "value": "0xFFFF_FFFD" }
    },
    "writable_fiom": true,
    "writable_hpm_counters": {
      "len": 32,
      // NUM_MHPMCOUNTERS=0; no HPM counters implemented
      "value": "0x00000000"
    },
    // U-mode supported; CY/TM/IR (bits 0-2) writable, no HPM counters
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x00000007"
    },
    // The bits in this value control whether the corresponding bits
    // of the `mcounteren` CSR that control access to HPM counters,
    // and `cycle`, `time` and `instret` registers at lower privilege
    // modes, are read-only zero. A set bit specifies that the
    // corresponding bit of `mcounteren` is writable, otherwise the
    // bit is read-only zero.
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // `mtvec.{direct,vectored}.supported` indicates whether the
    // corresponding mode is supported for `mtvec`.  At least one mode
    // should be supported.  If both modes are supported, the mode on
    // reset is unspecified.
    // The `mtvec.{direct,vectored}.base_alignment` parameters control the alignment
    // of the trap vector base for each mode.  The alignment is
    // specified as the power of 2 of the desired byte alignment, and
    // can range from a minimum of 2 upto a maximum of 24. If
    // unaligned values are written to these CSRs, the lowest bits
    // will be zeroed to respect the specified alignment.
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 7
      },
      "vectored": {
        "supported": true,
        "base_alignment": 7
      }
    },
    // Similar to `mtvec` above. If `S` mode is not supported, these
    // values need to be present and legal but are ignored.
    "stvec": {
      // The spec requires `base_alignment` for `stvec.direct` to be 2
      // (i.e. 4-byte alignment), hence there is no configuration
      // parameter for it.
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "vstvec": {
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "medeleg": {
      "delegatable_bits": {
        "len": 64,
        "value": "0x0000_0000_000c_b3FF"
      }
    },
    "mideleg": {
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x0000_2222"
      }
    },
    "xtval_nonzero": {
      // mtval hardwired to 0 (User Manual, Control and Status Registers)
      "illegal_instruction": false,
      "virtual_instruction": false,
      "load_guest_page_fault": false,
      "samo_guest_page_fault": false,
      "fetch_guest_page_fault": false,
      "software_breakpoint": false,
      "hardware_breakpoint": false,
      "load_address_misaligned": false,
      "load_access_fault": false,
      "load_page_fault": false,
      "samo_address_misaligned": false,
      "samo_access_fault": false,
      "samo_page_fault": false,
      "fetch_address_misaligned": false,
      "fetch_access_fault": false,
      "fetch_page_fault": false,
      "software_check": false,
      "hardware_error": true,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      // The legal values for the FS and VS fields in this CSR are
      // specified by the two fields below.  Their values can be one
      // of:
      // - "ExtContext_FourState" allows all values {Off, Initial, Clean, Dirty}.
      // - "ExtContext_TwoState" allows {Off, Dirty}, and writes of Initial and Clean get written as Dirty.
      // - "ExtContext_Off" allows only {Off}.  This makes the field read-only zero.
      "fs_legal_states": "ExtContext_Off",
      "vs_legal_states": "ExtContext_Off"
    },
    "privileged_isa_version": "Privileged_ISA_1_12"
  },
  "memory": {
    "physaddr_bits": 32,
    "asidlen": 9,
    "vmidlen": 7,
    "pmp": {
      "grain": 0,
      // PMP_NUM_REGIONS=0
      "count": 0,
      "usable_count": 0,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    "misaligned": {
      // misaligned handled as split bus transactions
      "byte_by_byte": false,
      "order_decreasing": false,
      "default_allowed_within_exp": 0,
      "exceptions": {
        "load_store": { "None": null },
        "vector": { "None": null },
        "lrsc": { "Some": "AccessFault" },
        "amo": { "Some": "AccessFault" }
      }
    },
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    "regions": [
      {
        "base": { "len": 64, "value": "0x0" },
        "size": { "len": 64, "value": "0x2000000" },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault",
            "lrsc": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      },
      // IO: CLINT at 0x2000000 + simple_interrupt_generator at 0x20C0000
      {
        "base": { "len": 64, "value": "0x2000000" },
        "size": { "len": 64, "value": "0x200000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": false,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "Some": "AlignmentException" },
            "amo": "AccessFault",
            "lrsc": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // covers rvmodel virtual peripheral addresses (0x10000000, 0x20000000)
      {
        "base": { "len": 64, "value": "0x2200000" },
        "size": { "len": 64, "value": "0x5DE00000" },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault",
            "lrsc": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      }
    ]
  },
  "platform": {
    // OpenHW Group JEDEC mvendorid=0x602=1538
    "vendorid": 1538,
    // marchid=0x15 (User Manual, Control and Status Registers)
    "archid": 21,
    "impid": 0,
    "hartid": 0,
    "cache_block_size_exp": 6,
    "reservation": {
      "reservation_set_size_exp": 3,
      "require_exact_reservation_addr": false,
      "invalidate_on_same_hart_store": false
    },
    "interrupts": {
      "machine": {
        "software": { "supported": true },
        "external": { "supported": true },
        "timer": { "supported": true }
      }
    },
    "clint": {
      "supported": true,
      "base": 33554432,
      "size": 786432
    },
    // 0x20C0000 = CLINT base + CLINT size
    "simple_interrupt_generator": {
      "supported": true,
      "base": 34340864
    },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    "wfi_is_nop": true,
    // WFI is optionally available to User mode.  Note that even if
    // `wfi_is_nop` is set to `true` above, it will still not be
    // available to User mode unless `wfi_available_to_user_mode` is
    // also `true`.
    "wfi_available_to_user_mode": true,
    "max_time_to_wait": 0,
    // The model can generate the following events that can be tracked
    // using the HPM counters:
    // - EV_FENCE
    // - EV_MISALIGNED_LOAD_EXCEPTION
    // - EV_MISALIGNED_STORE_EXCEPTION
    // - EV_TLB_MISS
    //
    // An event can be mapped to a selector value, that when written
    // to the event field of an `mhpmeventNN` CSR, will increment the
    // corresponding `mhpmcounterNN` CSR as per the specification
    // (e.g. the `Sscofpmf` extension).
    //
    // The selector values need to fit into the event field of an
    // `mhpmeventNN` CSR. When Sscofpmf is not supported, this field
    // is `base.hpmevent_width_bits` wide; with Sscofpmf, this field
    // is the lowest 56 bits of the 64-bit `mhpeventNN` CSR.
    //
    // The `event_selectors` list can contain any subset of these
    // supported events.  Events cannot be repeated in the list, and
    // the selector values should be unique.  These selector values
    // are always specified as 64-bit, but their values must fit the
    // width restrictions mentioned above.
    "event_selectors": []
  },
  "extensions": {
    "M": { "mutable_misa": false, "supported": true },
    "A": { "mutable_misa": false, "supported": false },
    "F": {
      "mutable_misa": false,
      "supported": false,
      "fflags_dirty_policy": "Fflags_Dirty_Precise"
    },
    "D": { "mutable_misa": false, "supported": false },
    "C": {
      "mutable_misa": false
    },
    "V": {
      "mutable_misa": false,
      "support_level": "Disabled",
      "vlen_exp": 7,
      "elen_exp": 6,
      "reserved_behavior": {
        "illegal_vtype": "IllegalVtype_SetVill",
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      "max_index_eew_exp": 5,
      "vstart": {
        "zero_required": {
          "arith": true,
          "scalar_move": true
        }
      }
    },
    "B": { "mutable_misa": false, "supported": false },
    "S": {
      "mutable_misa": false,
      "supported": false,
      "interrupts": {
        "software": { "supported": false },
        "external": { "supported": false },
        "timer": { "supported": false }
      }
    },
    "U": { "mutable_misa": false, "supported": true },

    "H": {
      "mutable_misa": false,
      "supported": false,
      "geilen": 31,
      "guest_page_fault_writes_htval": true,
      // Whether a trap into M or HS mode caused by the specified exception
      // writes the transformed trapping instruction to `mtinst`/`htinst`.
      // This applies to integer and floating-point loads and stores
      // (including compressed forms), LR/SC, AMOs, HLV/HLVX/HSV and CBOs.
      // If false, zero is written instead.
      "transformed_instruction": {
        "load_access_fault": true,
        "load_address_misaligned": true,
        "load_guest_page_fault": true,
        "load_page_fault": true,
        "samo_access_fault": true,
        "samo_address_misaligned": true,
        "samo_guest_page_fault": true,
        "samo_page_fault": true
      },
      "hgatp_modes": {
        "Sv32x4": false,
        "Sv39x4": false,
        "Sv48x4": false,
        "Sv57x4": false
      },
      "vsatp_modes": {
        "Sv32": true,
        "Sv39": false,
        "Sv48": false,
        "Sv57": false
      }
    },

    "Sha": { "supported": false },
    "Shcounterenw": { "supported": false },
    "Shgatpa": { "supported": false },
    "Shtvala": { "supported": false },
    "Shvsatpa": { "supported": false },
    "Shvstvala": { "supported": false },
    "Shvstvecd": { "supported": false },
    "Sstvecd": { "supported": false },
    "Svukte": { "supported": false },
    "Zilx": { "supported": false },
    "Zibi": { "supported": false },
    "Zicbom": { "supported": false },
    "Zicbop": { "supported": false },
    "Zicboz": { "supported": false },
    "Zic64b": { "supported": false },
    "Ziccamoa": { "supported": false },
    "Ziccamoc": { "supported": false },
    "Ziccif": { "supported": false },
    "Zicclsm": { "supported": false },
    "Ziccrse": { "supported": false },
    "Zicfilp": { "supported": false },
    "Zicfiss": { "supported": false },
    "Zicond": { "supported": false },
    "Zicntr": { "supported": true },
    "Zicsr": { "supported": true },
    "Zifencei": { "supported": true },
    "Zihintntl": { "supported": false },
    "Zihintpause": { "supported": false },
    "Zihpm": { "supported": false },
    "Zimop": { "supported": false },
    "Zmmul": { "supported": true },
    "Zaamo": { "supported": false },
    "Zabha": { "supported": false },
    "Zacas": { "supported": false },
    "Zalrsc": { "supported": false },
    "Zama16b": {
      "supported": false
    },
    "Zawrs": {
      "supported": false,
      "nto": { "is_nop": false },
      "sto": { "is_nop": false }
    },
    "Zfa": { "supported": false },
    "Zfbfmin": { "supported": false },
    "Zfh": { "supported": false },
    "Zfhmin": { "supported": false },
    "Zfinx": { "supported": false },
    "Zdinx": { "supported": false },
    "Zca": { "supported": true },
    "Zcf": { "supported": false },
    "Zcd": { "supported": false },
    "Zcb": { "supported": true },
    "Zcmop": { "supported": false },
    "Zba": { "supported": false },
    "Zbb": { "supported": false },
    "Zbs": { "supported": false },
    "Zbc": { "supported": false },
    "Zbkb": { "supported": false },
    "Zbkc": { "supported": false },
    "Zbkx": { "supported": false },
    "Zknd": { "supported": false },
    "Zkne": { "supported": false },
    "Zknh": { "supported": false },
    "Zkr": {
      "supported": false,
      "sseed_reset_value": false,
      "useed_reset_value": false,
      "sseed_read_only_zero": false,
      "useed_read_only_zero": false
    },
    "Zksed": { "supported": false },
    "Zksh": { "supported": false },
    "Zkt": { "supported": true },
    "Zhinx": { "supported": false },
    "Zhinxmin": { "supported": false },
    "Ssccptr": { "supported": false },
    "Sscofpmf": { "supported": false },
    "Sscounterenw": { "supported": false },
    "Sstc": { "supported": false },
    "Sstvala": { "supported": false },
    "Svinval": { "supported": false },
    "Svrsw60t59b": { "supported": false },
    "Smcntrpmf": { "supported": false },
    "Svbare": {
      "supported": false,
      "sfence_vma_illegal_if_svbare_only": true
    },
    "Svade": { "supported": false },
    "Svadu": { "supported": false },
    "Svnapot": { "supported": false },
    "Ssnpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Smnpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Smmpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Svpbmt": { "supported": false },
    "Svvptc": { "supported": false },
    "Sv32": { "supported": false },
    "Sv39": { "supported": false },
    "Sv48": { "supported": false },
    "Sv57": { "supported": false },
    "Stateen": {
      "Smstateen": { "supported": false },
      "Ssstateen": { "supported": false },
      "C_readonly_zero": true,
      "SE0_readonly_zero": false
    },
    "Ssqosid": {
      "supported": false,
      "rcid_length": 12,
      "mcid_length": 12
    },
    "Zvabd": { "supported": false },
    "Zvbb": { "supported": false },
    "Zvbc": { "supported": false },
    "Zvfbfmin": { "supported": false },
    "Zvfbfwma": { "supported": false },
    "Zvfh": { "supported": false },
    "Zvfhmin": { "supported": false },
    "Zvkb": { "supported": false },
    "Zvkg": { "supported": false },
    "Zvkned": { "supported": false },
    "Zvknha": { "supported": false },
    "Zvknhb": { "supported": false },
    "Zvksed": { "supported": false },
    "Zvksh": { "supported": false },
    "Zvkt": { "supported": false },
    "Sdtrig": {
      "supported": false,
      // `breakpoint_reentrancy` must be one of the below strings:
      // . `Use_tcontrol`: use the `mte` and `mpte` bits in the `tcontrol` CSR (this also makes the `tcontrol` CSR available)
      // . `Use_interrupt_enables`: use `mstatus.MIE` and the `SIE` bits in `sstatus` and `vsstatus`
      // . `No_reentrancy_support`: no specific support for reentrancy
      // Note: `Use_tcontrol` hardwires medeleg[3] to 0, which breaks the
      // `sbreak` test in `riscv-tests`.
      "breakpoint_reentrancy": "No_reentrancy_support",
      "etrigger": {
        "supported": false,
        // A bit set to 1 in this value specifies that the
        // corresponding exception is supported by the trigger.
        // Triggers for reserved exceptions are not supported.  This
        // value is ignored when `etrigger` is not supported.
        "supported_exceptions": { "len": "xlen", "value": "0" }
      },
      "hcontext": { "supported": false },
      // Triggers
      "icount": {
        "supported": false,
        "count_hardwired_one": false,
        // Whether a `tdata1` write to an `icount` trigger with
        // `count`=1 also makes it pending when that write's instruction
        // matches the trigger.
        "self_write_sets_pending": false
      },
      "itrigger": {
        "supported": false,
        // A bit set to 1 in this value specifies that the
        // corresponding interrupt is supported by the trigger.
        // Triggers for reserved interrupts are not supported.  This
        // value is ignored when `itrigger` is not supported.
        "supported_interrupts": { "len": "xlen", "value": "0" }
      },
      // CSRs
      "mcontext": { "supported": false },
      // The number of supported triggers.  This has to be
      // non-negative, and greater than 0 if Sdtrig is supported.
      // The model does not support more than 16 triggers.
      "num_triggers": 0,
      "scontext": { "supported": false }
    },
    // The double trap extensions are not enabled by default because
    // mstatus[MDT] is reset to 1. Unless the boot code clears it, the
    // first trap taken will result in an unexpected double trap.
    "Smdbltrp": { "supported": false },
    "Ssdbltrp": { "supported": false },
    "Ssstrict": { "supported": false }
  }
}
