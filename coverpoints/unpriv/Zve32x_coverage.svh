        // Value of VCSR.vxrm (vector fixed-point rounding mode)
        bins rnu  = {2'b00};
        bins rne  = {2'b01};
        bins rdn  = {2'b10};
        bins rod  = {2'b11};
    }

    cr_vxrm_vs2_imm_edges : cross cp_vs2_edges,cp_imm_edges_5bit_u,cp_csr_vxrm  iff (ins.trap == 0 )  {
