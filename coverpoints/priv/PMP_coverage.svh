      pmpcfg0_A_mode_is_TOR: coverpoint {get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "pmpcfg0", "pmpcfg0")} {
        wildcard bins OFF = {8'b00001???};
      }
    `endif
