        get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "int") == LOAD_PAGE_FAULT |
        get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "int") == STORE_AMO_PAGE_FAULT
        `ifndef MAXINDEXEEW_GE64
