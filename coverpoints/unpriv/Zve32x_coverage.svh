covergroup Zve32x_vmv2r_v_sew32_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vd_vs2_emul2
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vd_vs2_emul2 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.current.vd == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers, vd only even registers (widen)
        bins v0  = {v0 };
        bins v2  = {v2 };
        bins v4  = {v4 };
        bins v6  = {v6 };
        bins v8  = {v8 };
        bins v10 = {v10};
        bins v12 = {v12};
        bins v14 = {v14};
        bins v16 = {v16};
        bins v18 = {v18};
        bins v20 = {v20};
        bins v22 = {v22};
        bins v24 = {v24};
        bins v26 = {v26};
        bins v28 = {v28};
        bins v30 = {v30};
    }

    //// end cmp_vd_vs2_emul2////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vmv2r.v"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_emul2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_emul2 : coverpoint ins.get_vr_reg(ins.current.vd) iff (ins.trap == 0) {
        // VD register assignment (widening instruction, excluding odd registers)
        ignore_bins v1 = {v1};
        ignore_bins v3 = {v3};
        ignore_bins v5 = {v5};
        ignore_bins v7 = {v7};
        ignore_bins v9 = {v9};
        ignore_bins v11 = {v11};
        ignore_bins v13 = {v13};
        ignore_bins v15 = {v15};
        ignore_bins v17 = {v17};
        ignore_bins v19 = {v19};
        ignore_bins v21 = {v21};
        ignore_bins v23 = {v23};
        ignore_bins v25 = {v25};
        ignore_bins v27 = {v27};
        ignore_bins v29 = {v29};
        ignore_bins v31 = {v31};
    }

