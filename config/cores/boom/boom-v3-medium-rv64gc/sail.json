    "Stateen": {
      "Smstateen": {
        "supported": false
      },
      "Ssstateen": {
        "supported": false
      },
      // Each stateen bit is one of CSRBit_Writable,
      // CSRBit_ReadOnlyZero or CSRBit_ReadOnlyOne.
      // Bits for features the hart does not support must be
      // CSRBit_ReadOnlyZero. Bits that depend on misa (ENVCFG
      // on misa.S, P1P13 on misa.H) also read as zero while that
      // extension is disabled at run time.
      "mstateen0": {
        "SE0": "CSRBit_Writable",
        "ENVCFG": "CSRBit_ReadOnlyZero",
        "CONTEXT": "CSRBit_ReadOnlyZero",
        "P1P13": "CSRBit_ReadOnlyZero",
        "SRMCFG": "CSRBit_ReadOnlyZero",
        "FCSR": "CSRBit_ReadOnlyZero",
        "C": "CSRBit_ReadOnlyZero"
      },
      // Bit 63 of mstateen1, mstateen2 and mstateen3. These can only be
      // read-only zero if H is not supported.
      "mstateen1": {
        "SE1": "CSRBit_Writable"
      },
      "mstateen2": {
        "SE2": "CSRBit_Writable"
      },
      "mstateen3": {
        "SE3": "CSRBit_Writable"
      },
      // hstateen0.SE0 is always writable.
      "hstateen0": {
        "ENVCFG": "CSRBit_ReadOnlyZero",
        "CONTEXT": "CSRBit_ReadOnlyZero",
        "FCSR": "CSRBit_ReadOnlyZero",
        "C": "CSRBit_ReadOnlyZero"
      },
      "sstateen0": {
        "FCSR": "CSRBit_ReadOnlyZero",
        "C": "CSRBit_ReadOnlyZero"
      }
    },
    "Ssqosid": {
      "supported": false,
      "rcid_length": 12,
      "mcid_length": 12
    },
    "Svpbmt": {
      "supported": false
    },
    "Svvptc": {
      "supported": false
    },
    // Sdtrig, Smdbltrp, Ssdbltrp and Ssstrict are not claimed in the UDB configuration.
    "Sdtrig": {
      "supported": false,
      // `breakpoint_reentrancy` must be one of the below strings:
      // . `Use_tcontrol`: use the `mte` and `mpte` bits in the `tcontrol` CSR (this also makes the `tcontrol` CSR available)
      // . `Use_interrupt_enables`: use `mstatus.MIE` and the `SIE` bits in `sstatus` and `vsstatus`
      // . `No_reentrancy_support`: no specific support for reentrancy
      // Note: `Use_tcontrol` hardwires medeleg[3] to 0, which breaks the
      // `sbreak` test in `riscv-tests`.
      "breakpoint_reentrancy": "No_reentrancy_support",
      "etrigger": {
        "supported": false,
        // A bit set to 1 in this value specifies that the
        // corresponding exception is supported by the trigger.
        // Triggers for reserved exceptions are not supported.  This
        // value is ignored when `etrigger` is not supported.
        "supported_exceptions": { "len": "xlen", "value": "0" }
      },
      "hcontext": { "supported": false },
      // Triggers
      "icount": {
        "supported": false,
        "count_hardwired_one": false,
        // Whether a `tdata1` write to an `icount` trigger with
        // `count`=1 also makes it pending when that write's instruction
        // matches the trigger.
        "self_write_sets_pending": false
      },
      "itrigger": {
        "supported": false,
        // A bit set to 1 in this value specifies that the
        // corresponding interrupt is supported by the trigger.
        // Triggers for reserved interrupts are not supported.  This
        // value is ignored when `itrigger` is not supported.
        "supported_interrupts": { "len": "xlen", "value": "0" }
      },
      "mcontrol6": {
        "supported": false,
        // If `mcontrol6` is supported, this value needs to be in the range
        // 0 < `maskmax6` < XLEN.
        "maskmax6": 63,
        // Whether an address selection matches all the accessed addresses.
        // If set to `false`, it matches only the lowest address.
        "address_select_matches_all_addresses": true,
        // Maximum length of a chain. This cannot exceed the number of
        // triggers.  A value of 0 implies chains are not supported.
        "max_chain_length": 4
      },
      "textra": {
        // Which context matches are supported. Writes of unsupported
        // `mhselect` and `sselect` values are legalized to 0 (ignore).
        "mhselect": {
          // Values 1, 4 and 5, match on `mcontext`. Requires the
          // `mcontext` CSR. Values 1 and 5 also require H.
          "mcontext_match": false,
          // Values 2 and 6, match on the VMID in `hgatp`. Requires H.
          "vmid_match": false
        },
        "sselect": {
          // Value 1, match on `scontext`. Requires S and the `scontext`
          // CSR.
          "scontext_match": false,
          // Value 2, match on the ASID in `satp` or `vsatp`. Requires S.
          "asid_match": true
        },
        // The number of implemented `mhvalue` and `svalue` bits. Bits
        // above these are read only zero. At most 6 and 16 on RV32,
        // 13 and 32 on RV64.
        "mhvalue_len": 13,
        "svalue_len": 32
      },
      // CSRs
      "mcontext": { "supported": false },
      // The number of supported triggers.  This has to be
      // non-negative, and greater than 0 if Sdtrig is supported.
      // The model does not support more than 16 triggers.
      "num_triggers": 0,
      "scontext": { "supported": false }
    },
    "Smdbltrp": { "supported": false },
    "Ssdbltrp": { "supported": false },
    "Ssstrict": { "supported": false }
  }
