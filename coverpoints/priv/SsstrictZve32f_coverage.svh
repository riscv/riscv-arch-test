        end
        "vfnmacc.vv"     : begin
            SsstrictZve32f_vfnmacc_vv_cg.sample(ins);
        end
        "vfnmadd.vf"     : begin
            SsstrictZve32f_vfnmadd_vf_cg.sample(ins);
        end
        "vfnmadd.vv"     : begin
            SsstrictZve32f_vfnmadd_vv_cg.sample(ins);
        end
        "vfnmsac.vf"     : begin
            SsstrictZve32f_vfnmsac_vf_cg.sample(ins);
        end
        "vfnmsac.vv"     : begin
