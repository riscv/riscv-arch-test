        get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "int") == STORE_AMO_ACCESS_FAULT |
        get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "int") == LOAD_PAGE_FAULT |
