        // Cross coverage all legal LMULs for SEW = 32 and vl edges (1, random, vlmax)
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_imm_edges_u
    //////////////////////////////////////////////////////////////////////////////////

    cp_imm_edges_5bit_u : coverpoint unsigned'(ins.current.imm)  iff (ins.trap == 0 )  {
        bins b_0 = {0};
        bins b_1 = {1};
        bins b_2 = {2};
        bins b_15 = {15};
        bins b_16 = {16};
        bins b_30 = {30};
