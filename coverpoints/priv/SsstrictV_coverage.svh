// ---------------------
covergroup SsstrictV_vfmv_v_f_cg with function sample(ins_t ins);
    option.per_instance = 0;
    `include "general/RISCV_coverage_ssstrictv_helpers.svh"
// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_vfmv_vs2_not_v0_reserved
