// Sail reference-model configuration for XiangShan Kunminghu V2 (KunminghuV2Config).
// OpenXiangShan/XiangShan @ e7bab53e66dfb3c4a1d11cf9519b0396f8576cae (kunminghu-v2).
// Values agree with the UDB configuration in xiangshan-kmhv2.yaml, which cites the source of each.
// Source paths below are relative to src/main/scala/xiangshan/ (NewCSR/ is backend/fu/NewCSR/).
// Memory map: RAM at 0x8000_0000 (256 MiB used by the tests); CLINT at 0x3800_0000, as on the DUT.
// The simple interrupt generator at 0x3805_0000 exists only in the reference model. The DUT's
// PMA-denied range 0x3900_2000-0x39FF_FFFF (RVMODEL_ACCESS_FAULT_ADDRESS) is in no region.
// writable_fiom is true because Sail requires FIOM to be writable when Sv39 is supported; on the
// DUT menvcfg.FIOM is read-only zero.
{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.15/sail_riscv_config_schema.json",
  "base": {
    "xlen": 64,
    "E": false,
    // Whether a `mhpmcounter` increments if the event it is counting
    // was generated during a write to its corresponding `mhpmevent`
    // CSR (which could change the monitored event).
    // XiangShan selects events with the registered mhpmevent values (NewCSR/NewCSR.scala:1284-1306),
    // so the writing instruction's events are not counted with the new selector.
    "hpmcounter_increments_in_self_hpmevent_write": false,
    // The precision of the HPM counter, upto 64 bits.
    "hpmcounter_width_bits": 64,
    // The width of the `mhpmevent` CSRs, upto 64 bits, if Sscofpmf is
    // not supported.  On RV32 without Sscofpmf, this can be upto 32,
    // since the `mhpmeventh` CSRs are not accessible.
    // If Sscofpmf is supported, the `mhpmevent` CSRs are always 64
    // bits; this value then defines the number, upto 56, of the lowest
    // bits of the CSRs that are used as the event selector.
    // XiangShan: the event field is bits 54:0 (OPTYPE2..0 at 54:40, EVENT3..0 at 39:0);
    // bit 55 is not implemented (NewCSR/MachineLevel.scala:773-787). The OPTYPE fields
    // are WARL with legal values 0, 1, 2 and 4 (MachineLevel.scala:789-796), which Sail
    // does not model.
    "hpmevent_width_bits": 55,
    // XiangShan: CY, IR and HPM3-31 are writable (NewCSR/MachineLevel.scala:706-710).
    "mcountinhibit": {
      // Whether the `mcountinhibit` CSR is implemented.
      "supported": true,
      // This bits in this value control whether the corresponding
      // bits of the CSR are writable.  Note that bit 1 cannot be written
      // to as it is read-only zero.
      "writable_bits": { "len": 32, "value": "0xFFFF_FFFD" }
    },
    "writable_fiom": true,
    "writable_hpm_counters": {
      "len": 32,
      "value": "0xFFFF_FFF8"
    },
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
