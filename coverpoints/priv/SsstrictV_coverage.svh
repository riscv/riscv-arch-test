            `ifndef SEW16_SUPPORTED
                bins eew16 = {3'b101};  // width=101 -> EEW=16, reserved if SEWMIN > 16
            `endif
            `ifndef SEW32_SUPPORTED
                bins eew32 = {3'b110};  // width=110 -> EEW=32, reserved if SEWMIN > 32
            `endif
