    // cp_vs2_egs4_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4_sew64 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=64, so EGW=256 and LMUL * VLEN >= 256): a register group of LMUL starts at a
        // multiple of LMUL, so odd registers need VLEN >= 256, registers 2 mod 4 need VLEN >= 128 and
        // registers 4 mod 8 need VLEN >= 64
        `ifndef ZVL256B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL128B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10 = {v10};
            ignore_bins v14 = {v14};
            ignore_bins v18 = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v4  = {v4};
            ignore_bins v12 = {v12};
            ignore_bins v20 = {v20};
            ignore_bins v28 = {v28};
        `endif
    }

    //// end cp_vs2_egs4_sew64 ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew64 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul")  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 3) {
        // LMUL values for EGS=4, SEW=64 instructions: LMUL * VLEN must be at least EGW = 256
        bins eight = {3};
        bins four = {2};
        `ifdef ZVL128B_SUPPORTED
            bins two = {1};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins one = {0};
        `endif
    }

    cr_vl_lmul_egs4_sew64 : coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul")[2:0],
                                         3'(vl_check(ins.hart, ins.issue, 4))}  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 3)  {
        // LMUL crossed with vl = EGS, VLMAX and a value in between for EGS=4 instructions at SEW=64.
        // LMUL * VLEN must be at least EGW = 256, and VLMAX = VLEN * LMUL / SEW must hold at least two
        // element groups for a distinct VLMAX and four for a value in between.
        `ifdef ZVL256B_SUPPORTED
            bins one_one = {6'b000_001};
        `endif
        `ifdef ZVL512B_SUPPORTED
            bins one_vlmax = {6'b000_010};
        `endif
        `ifdef ZVL1024B_SUPPORTED
            bins one_legal = {6'b000_011};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins two_one = {6'b001_001};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins two_vlmax = {6'b001_010};
        `endif
        `ifdef ZVL512B_SUPPORTED
            bins two_legal = {6'b001_011};
        `endif
        `ifdef ZVL64B_SUPPORTED
            bins four_one = {6'b010_001};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins four_vlmax = {6'b010_010};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins four_legal = {6'b010_011};
        `endif
        bins eight_one = {6'b011_001};
        `ifdef ZVL64B_SUPPORTED
            bins eight_vlmax = {6'b011_010};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins eight_legal = {6'b011_011};
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew64////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs1_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs1_vd_edges_egs4 : cross cp_vs1_edges_egs4, cp_vd_edges_egs4  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VD edges (EGS=4)
    }

    //// end cr_vs1_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VD edges (EGS=4)
    }

    //// end cr_vs2_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vs1_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vs1_edges_egs4 : cross cp_vs2_edges_egs4, cp_vs1_edges_egs4  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VS1 edges (EGS=4)
    }

    //// end cr_vs2_vs1_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vta")[0]  iff (ins.trap == 0)  {}

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vma")[0]  iff (ins.trap == 0)  {}

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zvknhb64_vsha2ms_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vs1_vs2_egs4_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vs1_vs2_egs4_sew64 : coverpoint ins.get_vr_reg(ins.current.vs1)  iff (ins.current.vs1 == ins.current.vs2 & ins.trap == 0 )  {
        // Registers with vs1 = vs2 (EGS=4, SEW=64, so EGW=256 and LMUL * VLEN >= 256): a register group of LMUL starts at a
        // multiple of LMUL, so odd registers need VLEN >= 256, registers 2 mod 4 need VLEN >= 128 and
        // registers 4 mod 8 need VLEN >= 64
        `ifndef ZVL256B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL128B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10 = {v10};
            ignore_bins v14 = {v14};
            ignore_bins v18 = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v4  = {v4};
            ignore_bins v12 = {v12};
            ignore_bins v20 = {v20};
            ignore_bins v28 = {v28};
        `endif
    }

    //// end cmp_vs1_vs2_egs4_sew64 ////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vsha2ms.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }


    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vd))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        // Edge values of vd (EGS=4), assuming vl = 1
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_egs4_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_egs4_sew64 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment (EGS=4, SEW=64, so EGW=256 and LMUL * VLEN >= 256): a register group of LMUL starts at a
        // multiple of LMUL, so odd registers need VLEN >= 256, registers 2 mod 4 need VLEN >= 128 and
        // registers 4 mod 8 need VLEN >= 64
        `ifndef ZVL256B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL128B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10 = {v10};
            ignore_bins v14 = {v14};
            ignore_bins v18 = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v4  = {v4};
            ignore_bins v12 = {v12};
            ignore_bins v20 = {v20};
            ignore_bins v28 = {v28};
        `endif
    }

    //// end cp_vd_egs4_sew64 ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs1))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        // Edge values of vs1 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs1_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1_egs4_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1_egs4_sew64 : coverpoint ins.get_vr_reg(ins.current.vs1)  iff (ins.trap == 0 )  {
        // VS1 register assignment (EGS=4, SEW=64, so EGW=256 and LMUL * VLEN >= 256): a register group of LMUL starts at a
        // multiple of LMUL, so odd registers need VLEN >= 256, registers 2 mod 4 need VLEN >= 128 and
        // registers 4 mod 8 need VLEN >= 64
        `ifndef ZVL256B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL128B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10 = {v10};
            ignore_bins v14 = {v14};
            ignore_bins v18 = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v4  = {v4};
            ignore_bins v12 = {v12};
            ignore_bins v20 = {v20};
            ignore_bins v28 = {v28};
        `endif
    }

    //// end cp_vs1_egs4_sew64 ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_egs4 : coverpoint vs_edges_check_egs4(ins.hart, ins.issue, ins.get_vr_val_lmul4(ins.current.vs2))
        iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul") == 2)  {
        // Edge values of vs2 (EGS=4), assuming vl = 4
        bins zero       = {vs_zero      };   //  = {(`EGS*SEW){1'b0}},
        bins ones       = {vs_ones      };   //  = {(`EGS*SEW){1'b1}},
        bins walkodd    = {vs_walkodd   };   //  = {(`EGS*SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`EGS*SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(EGS*SEW){random}}
    }

    //// end cp_vs2_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_egs4_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_egs4_sew64 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment (EGS=4, SEW=64, so EGW=256 and LMUL * VLEN >= 256): a register group of LMUL starts at a
        // multiple of LMUL, so odd registers need VLEN >= 256, registers 2 mod 4 need VLEN >= 128 and
        // registers 4 mod 8 need VLEN >= 64
        `ifndef ZVL256B_SUPPORTED
            ignore_bins v1  = {v1};
            ignore_bins v3  = {v3};
            ignore_bins v5  = {v5};
            ignore_bins v7  = {v7};
            ignore_bins v9  = {v9};
            ignore_bins v11 = {v11};
            ignore_bins v13 = {v13};
            ignore_bins v15 = {v15};
            ignore_bins v17 = {v17};
            ignore_bins v19 = {v19};
            ignore_bins v21 = {v21};
            ignore_bins v23 = {v23};
            ignore_bins v25 = {v25};
            ignore_bins v27 = {v27};
            ignore_bins v29 = {v29};
            ignore_bins v31 = {v31};
        `endif

        `ifndef ZVL128B_SUPPORTED
            ignore_bins v2  = {v2};
            ignore_bins v6  = {v6};
            ignore_bins v10 = {v10};
            ignore_bins v14 = {v14};
            ignore_bins v18 = {v18};
            ignore_bins v22 = {v22};
            ignore_bins v26 = {v26};
            ignore_bins v30 = {v30};
        `endif

        `ifndef ZVL64B_SUPPORTED
            ignore_bins v4  = {v4};
            ignore_bins v12 = {v12};
            ignore_bins v20 = {v20};
            ignore_bins v28 = {v28};
        `endif
    }

    //// end cp_vs2_egs4_sew64 ////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_egs4_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_egs4_sew64 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul")  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 3) {
        // LMUL values for EGS=4, SEW=64 instructions: LMUL * VLEN must be at least EGW = 256
        bins eight = {3};
        bins four = {2};
        `ifdef ZVL128B_SUPPORTED
            bins two = {1};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins one = {0};
        `endif
    }

    cr_vl_lmul_egs4_sew64 : coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vlmul")[2:0],
                                         3'(vl_check(ins.hart, ins.issue, 4))}  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 3)  {
        // LMUL crossed with vl = EGS, VLMAX and a value in between for EGS=4 instructions at SEW=64.
        // LMUL * VLEN must be at least EGW = 256, and VLMAX = VLEN * LMUL / SEW must hold at least two
        // element groups for a distinct VLMAX and four for a value in between.
        `ifdef ZVL256B_SUPPORTED
            bins one_one = {6'b000_001};
        `endif
        `ifdef ZVL512B_SUPPORTED
            bins one_vlmax = {6'b000_010};
        `endif
        `ifdef ZVL1024B_SUPPORTED
            bins one_legal = {6'b000_011};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins two_one = {6'b001_001};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins two_vlmax = {6'b001_010};
        `endif
        `ifdef ZVL512B_SUPPORTED
            bins two_legal = {6'b001_011};
        `endif
        `ifdef ZVL64B_SUPPORTED
            bins four_one = {6'b010_001};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins four_vlmax = {6'b010_010};
        `endif
        `ifdef ZVL256B_SUPPORTED
            bins four_legal = {6'b010_011};
        `endif
        bins eight_one = {6'b011_001};
        `ifdef ZVL64B_SUPPORTED
            bins eight_vlmax = {6'b011_010};
        `endif
        `ifdef ZVL128B_SUPPORTED
            bins eight_legal = {6'b011_011};
        `endif
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_egs4_sew64////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs1_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs1_vd_edges_egs4 : cross cp_vs1_edges_egs4, cp_vd_edges_egs4  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VD edges (EGS=4)
    }

    //// end cr_vs1_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vd_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vd_edges_egs4 : cross cp_vs2_edges_egs4, cp_vd_edges_egs4  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VD edges (EGS=4)
    }

    //// end cr_vs2_vd_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vs1_edges_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vs1_edges_egs4 : cross cp_vs2_edges_egs4, cp_vs1_edges_egs4  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VS1 edges (EGS=4)
    }

    //// end cr_vs2_vs1_edges_egs4////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_egs4
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta_egs4 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vta")[0]  iff (ins.trap == 0)  {}

    cp_csr_vtype_vma_egs4 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VTYPE, "vma")[0]  iff (ins.trap == 0)  {}

    mask_enabled_agnostic_egs4: coverpoint ins.current.insn[25] {
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_egs4 : cross cp_csr_vtype_vta_egs4, cp_csr_vtype_vma_egs4, mask_enabled_agnostic_egs4  iff (ins.trap == 0)  {
        // Cross coverage of vector tail and mask agnostic behaviors (EGS=4)
    }

    //// end cr_vtype_agnostic_egs4////////////////////////////////////////////////

endgroup
// ---------------------
function void zvknhb64_sample(int hart, int issue, ins_t ins);
    string inst_name = traceDataQ[hart][issue][0].inst_name;

    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_field(hart, issue, `SAMPLE_BEFORE, CSR_VTYPE, "vsew") == 3 ||
        get_csr_field(hart, issue, `SAMPLE_BEFORE, CSR_VTYPE, "vill") == 1) begin
        case (inst_name)
            "vsha2ch.vv"     : begin
                Zvknhb64_vsha2ch_vv_cg.sample(ins);
            end
            "vsha2cl.vv"     : begin
                Zvknhb64_vsha2cl_vv_cg.sample(ins);
            end
            "vsha2ms.vv"     : begin
                Zvknhb64_vsha2ms_vv_cg.sample(ins);
            end
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
endfunction
