{
  "ignorePatterns": [
    {
      "pattern": "^(?!https://docs\\.openhwfoundation\\.org/)",
      "reason": "Only docs.openhwfoundation.org links; .markdown-link-check.config checks the rest"
    }
  ],
  "timeout": "30s",
  "retryOn429": true,
  "retryCount": 5,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 429, 502, 503, 504]
}
