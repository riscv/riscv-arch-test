{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.16/sail_riscv_config_schema.json",
  "base": {
    "xlen": 32,
    // RV32E: 16 GPRs.  An instruction that names x16-x31 raises illegal instruction.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/iu/rtl/cr_iu_decd.v#L758-L760
    "E": true,
    // E902 has no mhpmcounter3-31 or mhpmevent3-31 (see writable_hpm_counters), so the
    // four HPM settings below have no effect.
    "hpmcounter_increments_in_self_hpmevent_write": false,
    "hpmcounter_width_bits": 64,
    "hpmevent_width_bits": 32,
    // mcountinhibit (0x320) is not in the CSR decoder.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/cp0/rtl/cr_cp0_iui.v#L539-L590
    "mcountinhibit": {
      "supported": false,
      "writable_bits": {
        "len": 32,
        "value": "0x0"
      }
    },
    // menvcfg does not exist (privileged 1.10), and there is no S-mode or paging.
    "writable_fiom": false,
    // mhpmcounter3-31, mhpmcounter3h-31h, mhpmevent3-31 and mcounteren are not in the CSR
    // decoder and raise illegal instruction.  RVMODEL_INVISIBLE_TRAP_HANDLER emulates M-mode
    // accesses to them as read-only zero, which is what these zero masks give Sail.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/cp0/rtl/cr_cp0_iui.v#L539-L590
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x0"
    },
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // mtvec.MODE is hardwired to 3 (CLIC mode), which Sail cannot model.  In that mode an
    // exception goes to BASE with bits 5:2 cleared, the same as direct mode with a 64-byte
    // (2^6) aligned BASE.  Vectoring applies only to CLIC hardware-vectored interrupts.
    // Reads of mtvec return MODE = 3 where Sail returns 0.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/cp0/rtl/cr_cp0_oreg.v#L501-L506
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/cp0/rtl/cr_cp0_oreg.v#L983
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 6
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    // No S-mode; these values must be present and legal but are ignored.
    "stvec": {
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "vstvec": {
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    // No S-mode, so medeleg and mideleg do not exist.
    "medeleg": {
      "delegatable_bits": {
        "len": 64,
        "value": "0x0"
      }
    },
    "mideleg": {
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x0"
      }
    },
    // mtval follows user manual Table 4.3 (section 4.1.1): the access address for causes 1, 4,
    // 5, 6 and 7, the instruction encoding for cause 2, and 0 for causes 3 (ebreak), 8 and 11.
    "xtval_nonzero": {
      "illegal_instruction": true,
      "virtual_instruction": false,
      "load_guest_page_fault": false,
      "samo_guest_page_fault": false,
      "fetch_guest_page_fault": false,
      "software_breakpoint": false,
      "hardware_breakpoint": false,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "load_page_fault": false,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "samo_page_fault": false,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true,
      "fetch_page_fault": false,
      "software_check": false,
      "hardware_error": false,
      "reserved_exceptions": false
    },
    // pmpcfg R=0/W=1 is reserved; E902 stores it as written (the UDB feature extractor read
    // pmp0cfg back as 0x2), which none of Sail's pmpcfg_write_only choices models.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/pmp/rtl/cr_pmp_regs.v#L344-L348
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      "fs_legal_states": "ExtContext_Off",
      "vs_legal_states": "ExtContext_Off"
    },
    // The user manual (section 1.6) names privileged specification 1.10; 1.11 is the lowest Sail
    // offers.  There is no mstatush, menvcfg or mconfigptr.
    "privileged_isa_version": "Privileged_ISA_1_11"
  },
  "memory": {
    // UDB allows at most 32 physical address bits on RV32 without Sv32.  The pmpaddr
    // registers keep all 32 written bits (address bits 33:2).
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/pmp/rtl/cr_pmp_regs.v#L602-L610
    "physaddr_bits": 32,
    "invalid_physical_address": {
      "None": null
    },
    "asidlen": 9,
    "vmidlen": 7,
    // pmpcfg0-3 and pmpaddr0-15 are decoded; entries 0-7 are implemented with a 4-byte grain
    // and every address mode, and entries 8-15 read 0.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/pmp/rtl/cr_pmp_regs.v#L582-L721
    "pmp": {
      "grain": 0,
      "count": 16,
      "usable_count": 8,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    // Every misaligned load or store raises a misaligned exception: the LSU splitter is tied off.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/lsu/rtl/cr_lsu_unalign.v#L151
    "misaligned": {
      "exceptions": {
        "load_store": {
          "Some": "AlignmentException"
        },
        "vector": {
          "None": null
        },
        "lrsc": {
          "Some": "AlignmentException"
        },
        "amo": {
          "Some": "AlignmentException"
        }
      },
      "default_allowed_within_exp": 0,
      "byte_by_byte": false,
      "order_decreasing": false
    },
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    // 0x0000_0000: the 512 KB instruction-bus SRAM, which holds the whole test image and the
    // trap-trampoline block at 0x7_F000 (see link.ld).
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/smart_run/logical/mem/iahb_mem_ctrl.v#L96
    // 0x5000_0000: Sail's CLINT and interrupt generator, which ACT requires.  On the DUT this
    // range goes to the system bus error slave.
    // 0x6000_0000: the 1 MB system-bus SRAM that holds the testbench console word at 0x6000_FFF8.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/smart_run/logical/ahb/ahb.v#L16-L27
    "regions": [
      {
        "base": {
          "len": 64,
          "value": "0x00000000"
        },
        "size": {
          "len": 64,
          "value": "0x00080000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "None": null
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      },
      {
        "base": {
          "len": 64,
          "value": "0x50000000"
        },
        "size": {
          "len": 64,
          "value": "0x00200000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "None": null
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      {
        "base": {
          "len": 64,
          "value": "0x60000000"
        },
        "size": {
          "len": 64,
          "value": "0x00100000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "None": null
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      }
    ]
  },
  "platform": {
    // mvendorid = 0x5B7; marchid, mimpid and mhartid read 0.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/cp0/rtl/cr_cp0_oreg.v#L744-L751
    "vendorid": 1463,
    "archid": 0,
    "impid": 0,
    "hartid": 0,
    "cache_block_size_exp": 6,
    "reservation": {
      "reservation_set_size_exp": 3,
      "require_exact_reservation_addr": false,
      "invalidate_on_same_hart_store": false
    },
    // In CLIC mode mie and mip read 0 and ignore writes; every interrupt is enabled and
    // reported through the CLIC.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/cp0/rtl/cr_cp0_oreg.v#L635-L646
    "interrupts": {
      "machine": {
        "software": {
          "supported": false
        },
        "external": {
          "supported": false
        },
        "timer": {
          "supported": false
        }
      }
    },
    // ACT's signature build needs Sail's CLINT and simple interrupt generator.  They sit in an
    // IO region (0x5000_0000) that is not DUT memory; the E902 CLINT is reached only through
    // the CLIC.
    "clint": {
      "supported": true,
      "base": 1342177280,
      "size": 786432
    },
    "simple_interrupt_generator": {
      "supported": true,
      "base": 1343225856
    },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    "wfi_is_nop": true,
    // WFI in U-mode always raises illegal instruction; there is no mstatus.TW.
    //   https://github.com/T-head-Semi/opene902/blob/991836411b405ac6a0a8d7668f2f5de6fa2a5b8c/E902_RTL_FACTORY/gen_rtl/iu/rtl/cr_iu_decd.v#L731-L734
    "wfi_available_to_user_mode": false,
    "max_time_to_wait": 1000,
    // No HPM counters, so no events.
    "event_selectors": []
  },
