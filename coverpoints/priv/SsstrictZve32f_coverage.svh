        end
        "vfmadd.vf"     : begin
            SsstrictZve32f_vfmadd_vf_cg.sample(ins);
        end
        "vfmadd.vv"     : begin
            SsstrictZve32f_vfmadd_vv_cg.sample(ins);
        end
        "vfmax.vf"     : begin
            SsstrictZve32f_vfmax_vf_cg.sample(ins);
        end
        "vfmax.vv"     : begin
            SsstrictZve32f_vfmax_vv_cg.sample(ins);
        end
        "vfmerge.vfm"     : begin
            SsstrictZve32f_vfmerge_vfm_cg.sample(ins);
        end
