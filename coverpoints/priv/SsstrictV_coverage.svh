    vd_is_v0_meqv0 : coverpoint ins.current.insn[11:7] { bins v0 = { 5'b00000 }; }
    cp_ssstrictv_masking_vd_eq_v0 : cross std_trap_vec, vtype_lmul_1, vd_is_v0_meqv0, mask_enabled;

//// end cp_ssstrictv_masking_vd_eq_v0 //////////////////////////////////////////////////////////////////////////////////////////////

