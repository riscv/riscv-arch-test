               ins.current.insn[14:12] inside {3'b111
                   `ifndef MAXINDEXEEW_GE32
                       , 3'b110
                       `ifndef MAXINDEXEEW_GE16
                           , 3'b101
                       `endif
                   `endif
               } &&
               get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "int") == ILLEGAL_INSTRUCTION)
