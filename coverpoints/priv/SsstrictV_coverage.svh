// ---------------------
covergroup SsstrictV_vmv_s_x_cg with function sample(ins_t ins);
    option.per_instance = 0;
    `include "general/RISCV_coverage_ssstrictv_helpers.svh"
// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_vmv_xs_sx_vm0_reserved
// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // vmv.x.s (funct6=010000, funct3=010) and vmv.s.x (funct6=010000, funct3=110) with vm=0 are reserved
    vmv_xs_sx_funct6: coverpoint ins.current.insn[31:26] {
        bins vmv = {6'b010000};
    }

    vmv_xs_sx_funct3: coverpoint ins.current.insn[14:12] {
        bins vmv = {3'b010, 3'b110};
    }

    vm_masked: coverpoint ins.current.insn[25] {
        bins masked = {1'b0};
    }

    cp_ssstrictv_vmv_xs_sx_vm0_reserved: cross std_trap_vec, vmv_xs_sx_funct6, vmv_xs_sx_funct3, vm_masked;

//// end cp_ssstrictv_vmv_xs_sx_vm0_reserved /////////////////////////////////////////////////////////////

endgroup
// ---------------------
covergroup SsstrictV_vmv_v_i_cg with function sample(ins_t ins);
    option.per_instance = 0;
    `include "general/RISCV_coverage_ssstrictv_helpers.svh"
// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_vmv_vs2_not_v0_reserved
// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // vmv.v.v: vs2 must be v0, any other register is reserved
    vs2_not_v0: coverpoint ins.current.insn[24:20] {
        bins not_v0[] = {[1:31]};
    }

    cp_ssstrictv_vmv_vs2_not_v0_reserved: cross std_trap_vec, vs2_not_v0;

//// end cp_ssstrictv_vmv_vs2_not_v0_reserved //////////////////////////////////////////////////////////

endgroup
