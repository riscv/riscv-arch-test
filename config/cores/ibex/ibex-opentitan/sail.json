{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.14.1/sail_riscv_config_schema.json",
  "base": {
    "xlen": 32,
    "E": false,
    "writable_misa": false,
    // menvcfg (and menvcfgh) read as zero and ignore writes on Ibex, so menvcfg.FIOM
    // is not writable.  MEASURED: a write of all-ones to 0x30A reads back 0.
    //   Quote: "// menvcfg: machine environment configuration, all zeros for Ibex
    //   (none of the relevant features are implemented)
    //   CSR_MENVCFG, CSR_MENVCFGH: csr_rdata_int = '0;"
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/rtl/ibex_cs_registers.sv#L447-L449
    "writable_fiom": false,
    // MHPMCounterNum = 10 in the opentitan configuration, so mhpmcounter3..12 exist
    // (bits 3..12 = 0x1FF8) and 13..31 are read-only zero.  Must agree with
    // HPM_COUNTER_EN in ibex-opentitan.yaml.
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/doc/03_reference/performance_counters.rst#L90
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x0000_1FF8"
    },
    // The top 29 bits control whether the corresponding bits of `scounteren`
    // that control HPM counters are read-only zero. CV32E20 has no S-mode,
    // so all bits are read-only zero.
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // The bits in this value control whether the corresponding bits
    // of the `mcounteren` CSR that control access to HPM counters,
    // and `cycle`, `time` and `instret` registers at lower privilege
    // modes, are read-only zero. A set bit specifies that the
    // corresponding bit of `mcounteren` is writable, otherwise the
    // bit is read-only zero.
    // CY (bit 0), IR (bit 2) and HPM3..HPM12 (bits 3..12) are writable; TM (bit 1) is
    // read-only zero because Ibex has no time CSR, and bits 13..31 are read-only zero.
    // MEASURED: writing all-ones to mcounteren reads back 0x00001FFD.
    //   Quote: "1 | R | **TM:** Always reads as zero. The ``time`` CSR is not implemented."
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/doc/03_reference/cs_registers.rst#L242
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0x0000_1FFD"
    },
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // `mtvec.{direct,vectored}.supported` indicates whether the
    // corresponding mode is supported for `mtvec`.  At least one mode
    // should be supported.  If both modes are supported, the mode on
    // reset is unspecified.
    // The `mtvec.{direct,vectored}.base_alignment` parameters control the alignment
    // of the trap vector base for each mode.  The alignment is
    // specified as the power of 2 of the desired byte alignment, and
    // can range from a minimum of 2 upto a maximum of 24. If
    // unaligned values are written to these CSRs, the lowest bits
    // will be zeroed to respect the specified alignment.
    // Ibex hardwires mtvec MODE to 1 (Vectored) and forces BASE to a 256-byte boundary
    // (2^8).  Direct mode does not exist.  Must agree with MTVEC_MODES and
    // MTVEC_BASE_ALIGNMENT_VECTORED in ibex-opentitan.yaml.
    //   Quote: "1:0 **MODE:** Always set to 2'b01 to indicate vectored interrupt
    //   handling (read-only)."
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/doc/03_reference/cs_registers.rst#L219
    // MEASURED: writing 0x12345678 to mtvec reads back 0x12345601.
    "mtvec": {
      "direct": {
        "supported": false,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 8
      }
    },
    // Similar to `mtvec` above. If `S` mode is not supported, these
    // values need to be present and legal but are ignored.
    "stvec": {
      // The spec requires `base_alignment` for `stvec.direct` to be 2
      // (i.e. 4-byte alignment), hence there is no configuration
      // parameter for it.
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "vstvec": {
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "medeleg": {
      "delegatable_bits": {
        "len": 64,
        "value": "0x0000_0000_000c_b3FF"
      }
    },
    "mideleg": {
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x0000_2222"
      }
    },
    // These settings control whether the specified exceptions
    // cause information to be written into the appropriate
    // `xtval` registers.
    "xtval_nonzero": {
      "illegal_instruction": true,
      "virtual_instruction": false,
      "load_guest_page_fault": false,
      "samo_guest_page_fault": false,
      "fetch_guest_page_fault": false,
      "software_breakpoint": false,
      "hardware_breakpoint": false,
      "load_address_misaligned": false,
      "load_access_fault": true,
      "load_page_fault": false,
      "samo_address_misaligned": false,
      "samo_access_fault": true,
      "samo_page_fault": false,
      "fetch_address_misaligned": false,
      "fetch_access_fault": true,
      "fetch_page_fault": false,
      "software_check": false,
      "hardware_error": true,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      // The configuration option determines how to handle the reserved behavior `amocas_odd_registers`.
      // "AMOCAS_Fatal"  – raise a Sail exception, stopping execution.
      // "AMOCAS_Illegal" – treat it as an illegal instruction.
      "amocas_odd_register": "AMOCAS_Illegal",
      // The configuration option determines how to handle execution of a floating-point
      // instruction with DYN (dynamic) rounding mode when `fcsr.FRM` contains a
      // reserved value (0b101, 0b110, 0b111).
      // This does not affect the execution of floating-point instructions that have a
      // reserved rounding mode statically encoded in the instruction.
      // "Fcsr_RM_Fatal"  – raise a Sail exception, stopping execution.
      // "Fcsr_RM_Illegal" – treat it as an illegal instruction.
      "fcsr_rm": "Fcsr_RM_Illegal",
      // The configuration option determines how to handle the reserved behavior `pmpcfg_with_R0W1`.
      // "PMP_Fatal"  – raise a Sail exception, stopping execution.
      // "PMP_ClearPermissions" – convert a PMP entry with R=0, W=1 to R=0, W=0, X=0.
      "pmpcfg_write_only": "PMP_ClearPermissions",
      // The configuration option determines how to handle the reserved behavior `xenvcfg.CBIE` with 0b10.
      // "Xenvcfg_Fatal"  – raise a Sail exception, stopping execution.
      // "Xenvcfg_ClearPermissions" – convert CBIE with 0b10 to 0b00.
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      // The configuration option determines how to handle the reserved behavior `xtvec[Mode] >= 2`.
      // "Xtvec_Fatal"  – raise a Sail exception, stopping execution.
      // "Xtvec_Ignore" – use old Mode of xtvec.
      "xtvec_mode": "Xtvec_Ignore",
      // The configuration option determines how to handle the reserved behavior: Odd-numbered registers for RV32Zdinx.
      // "Zdinx_Fatal"  – raise a Sail exception, stopping execution.
      // "Zdinx_Illegal" – treat it as an illegal instruction.
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      // The legal values for the FS and VS fields in this CSR are
      // specified by the two fields below.  Their values can be one
      // of:
      // - "ExtContext_FourState" allows all values {Off, Initial, Clean, Dirty}.
      // - "ExtContext_TwoState" allows {Off, Dirty}, and writes of Initial and Clean get written as Dirty.
      // - "ExtContext_Off" allows only {Off}.  This makes the field read-only zero.
      "fs_legal_states": "ExtContext_Off",
      "vs_legal_states": "ExtContext_Off"
    },
    "privileged_isa_version": "Privileged_ISA_1_12"
  },
  "memory": {
    "physaddr_bits": 32,
    "asidlen": 9,
    "vmidlen": 7,
    "pmp": {
      // PMPGranularity = 0 (G=0, 4-byte granule), so NA4 is available.
      //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/ibex_configs.yaml#L57
      "grain": 0,
      // PMPNumRegions = 16 in the opentitan configuration; pmpaddr0..15 all exist.
      //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/ibex_configs.yaml#L58
      "count": 16,
      "usable_count": 16,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    // These settings control global support for misaligned access so they are
    // checked before address translation. `misaligned_exceptions` in
    // `regions` is checked after address translation.
    "misaligned": {
      // Ibex splits a misaligned load/store into two aligned bus transactions and
      // never raises a misaligned exception; the exception-cause table has no code 4
      // or code 6 entry.
      //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/doc/03_reference/exception_interrupts.rst#L106-L128
      "exceptions": {
        "load_store": { "None": null },
        "vector": { "None": null },
        "lrsc": { "Some": "AccessFault" },
        "amo": { "Some": "AccessFault" }
      },
      "default_allowed_within_exp": 0,
      "byte_by_byte": false,
      "order_decreasing": false
    },
    // Address to write DTB to (if provided).
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    "regions": [
      // Main memory: the Ibex Simple System 1 MB RAM at 0x0010_0000.  Tests link
      // from 0x0010_0080, the reset vector (see link.ld).
      //   Quote: "assign cfg_device_addr_base[Ram] = 32'h100000;
      //           assign cfg_device_addr_mask[Ram] = ~32'hFFFFF; // 1 MB"
      //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/examples/simple_system/rtl/ibex_simple_system.sv#L118-L119
      {
        "base": {
          "len": 64,
          "value": "0x100000"
        },
        "size": {
          "len": 64,
          "value": "0x100000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          // Ibex handles misaligned loads/stores in hardware; no per-region fault.
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault",
            "lrsc": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      },
      // IO memory for the reference model only: Sail's CLINT at 0x0200_0000 and its
      // simple interrupt generator at 0x0C00_0000.  The DUT's own devices (SimCtrl at
      // 0x0002_0000, Timer at 0x0003_0000) are deliberately NOT mapped here: the Sail
      // signature ELF is built with sail_macros.h, which replaces every DUT address
      // (console, halt, mtime, mtimecmp, msip) with the HTIF/CLINT equivalents.
      // RVMODEL_ACCESS_FAULT_ADDRESS (0x0040_0000) is outside every region on purpose,
      // so both the DUT and Sail fault on it.
      {
        "base": {
          "len": 64,
          "value": "0x2000000"
        },
        "size": {
          "len": 64,
          "value": "0xE000000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault",
            "lrsc": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      }
    ]
  },
  "platform": {
    // mvendorid = 0 and mimpid = 0 (both are integration parameters that Simple System
    // leaves at their zero defaults); marchid = 22.
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/rtl/ibex_pkg.sv#L727
    "vendorid": 0,
    "archid": 22,
    "impid": 0,
    "hartid": 0,
    // Cache block size, specified as a power of 2.
    "cache_block_size_exp": 6,
    "reservation": {
      // Reservation set size/alignment as a power of 2. Minimum 2 on RV32.
      "reservation_set_size_exp": 3,
      // Ibex has no A extension so LR/SC is never executed.
      "require_exact_reservation_addr": false,
      // Some implementations (e.g. SiFive U74) also invalidate the
      // reservation on stores from the same hart.  If this is set to `true`, the
      // model invalidates the reservation if a store from the same hart lies within
      // the reservation set.
      "invalidate_on_same_hart_store": false
    },
    "interrupts": {
      "machine": {
        "software": { "supported": true },
        "external": { "supported": true },
        "timer": { "supported": true }
      }
    },
    "clint": {
      "supported": true,
      // This must be in a suitable memory region (see `memory.regions`).
      "base": 33554432,
      "size": 786432
    },
    // Simple MMIO device to generate interrupts for testing purposes.
    "simple_interrupt_generator": {
      "supported": true,
      // Must be 4-byte aligned and within a memory region. Size is always 0x20.
      "base": 201326592
    },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    "wfi_is_nop": false,
    // WFI is optionally available to User mode.  Note that even if
    // `wfi_is_nop` is set to `true` above, it will still not be
    // available to User mode unless `wfi_available_to_user_mode` is
    // also `true`.
    "wfi_available_to_user_mode": true,
    "max_time_to_wait": 1000
  },
  "extensions": {
    "M": {
      "supported": true
    },
    "A": {
      "supported": false
    },
    "F": {
      "supported": false,
      "fflags_dirty_policy": "Fflags_Dirty_Precise"
    },
    "D": {
      "supported": false
    },
    "V": {
      // `support_level` must be one of the below strings:
      // . "Disabled" for no vector extension support
      // . "Integer" for Zve*x support
      // . "Float_single" for Zve*f support
      // . "Float_double" for Zve*d support
      // . "Full" for the full V extension
      // Note that `support_level` requires compatible
      // values for `vlen_exp` and `elen_exp` below.
      // For e.g. Zve32x and Zve32f require `elen_exp` >= 5,
      // Zve64x, Zve64f, and Zve64d require `elen_exp` >= 6,
      // and V requires `elen_exp` >= 6 and `vlen_exp` >= 7.
      "support_level": "Disabled",
      "vlen_exp": 7,
      "elen_exp": 6,
      "reserved_behavior": {
        // This determines how to handle attempts by vsetvli, vsetivli,
        // and vsetvl to set an unsupported or reserved vtype.
        // "IllegalVtype_SetVill" - set vtype.vill, set vl to zero, clear vstart, and write rd.
        // "IllegalVtype_Illegal" - treat it as an illegal instruction.
        // "IllegalVtype_Fatal"   - raise a Sail exception, stopping execution.
        "illegal_vtype": "IllegalVtype_SetVill",
        // This determines how to handle an out-of-bounds vstart (vstart >= VLMAX), which the
        // vector spec marks reserved and recommends, but does not require, trapping.
        // "Vstart_Illegal" - raise an illegal instruction exception.
        // "Vstart_Ignore"  - treat as a no-op, the instruction writes nothing.
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      // The maximum index EEW for indexed vector addressing mode, as
      // a power of 2.  This must be at least 3 but must not exceed
      // the supported ELEN.
      "max_index_eew_exp": 5,
      "vstart": {
        // The vector specification permits implementations to raise an
        // illegal instruction exception when `vstart` is non-zero for
        // instructions that cannot produce such a `vstart` value through
        // normal execution.
        "zero_required": {
          // Whether vector arithmetic instructions raise an illegal instruction
          // exception when `vstart` is non-zero. This also governs instructions
          // from the Zvbb, Zvbc, Zvabd, Zvfbfmin, and Zvfbfwma extensions.
          "arith": true,
          // Whether the vector scalar move instructions (vmv.x.s, vmv.s.x,
          // vfmv.f.s and vfmv.s.f) raise an illegal instruction exception when
          // `vstart` is non-zero.
          "scalar_move": true
        }
      }
    },
    // misa.B MEASURED as 0 (misa = 0x4090_1104) even though Zba/Zbb/Zbs are all
    // present, so the B extension itself is not claimed.
    "B": {
      "supported": false
    },
    "S": {
      "supported": false,
      "interrupts": {
        "software": { "supported": true },
        "external": { "supported": true },
        "timer": { "supported": true }
      }
    },
    // Ibex supports M-mode and U-mode.
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/doc/03_reference/exception_interrupts.rst#L23
    "U": {
      "supported": true
    },

    "H": {
      "supported": false,
      "geilen": 31,
      "guest_page_fault_writes_htval": true,
      "hgatp_modes": {
        "Sv32x4": false,
        "Sv39x4": false,
        "Sv48x4": false,
        "Sv57x4": false
      },
      "vsatp_modes": {
        "Sv32": true,
        "Sv39": false,
        "Sv48": false,
        "Sv57": false
      }
    },

    "Sha": { "supported": false },
    "Shcounterenw": { "supported": false },
    "Shgatpa": { "supported": false },
    "Shtvala": { "supported": false },
    "Shvsatpa": { "supported": false },
    "Shvstvala": { "supported": false },
    "Shvstvecd": { "supported": false },
    "Sstvecd": { "supported": false },
    "Svukte": { "supported": false },
    "Zilx": { "supported": false },
    "Zibi": {
      "supported": false
    },
    "Zicbom": {
      "supported": false
    },
    "Zicbop": {
      "supported": false
    },
    "Zicboz": {
      "supported": false
    },
    // This extension just asserts that the cache block size is 64 bytes.
    // If you enable this you also need to ensure `platform.cache_block_size_exp`
    // is 6, otherwise you will get a config validation error.
    "Zic64b": {
      "supported": false
    },
    "Ziccamoa": {
      "supported": false
    },
    "Ziccamoc": {
      "supported": false
    },
    "Ziccif": {
      "supported": false
    },
    "Zicclsm": {
      "supported": false
    },
    "Ziccrse": {
      "supported": false
    },
    "Zicfilp": {
      "supported": false
    },
    "Zicfiss": {
      "supported": false
    },
    "Zicond": {
      "supported": false
    },
    // cycle/instret exist as U-mode aliases; time does not, which is expressed by
    // TIME_CSR_IMPLEMENTED: false in ibex-opentitan.yaml.  ACT emulates time reads
    // from the memory-mapped mtime in its invisible trap handler.
    "Zicntr": {
      "supported": true
    },
    "Zicsr": {
      "supported": true
    },
    "Zifencei": {
      "supported": true
    },
    "Zihintntl": {
      "supported": false
    },
    "Zihintpause": {
      "supported": false
    },
    // hpmcounter3..31 exist as read-only U-mode aliases gated by mcounteren; only
    // 3..12 are backed by real counters (see writable_hpm_counters above).
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/doc/03_reference/performance_counters.rst#L11
    "Zihpm": {
      "supported": true
    },
    "Zimop": {
      "supported": false
    },
    "Zmmul": {
      "supported": false
    },
    "Zaamo": {
      "supported": false
    },
    "Zabha": {
      "supported": false
    },
    "Zacas": {
      "supported": false
    },
    "Zalrsc": {
      "supported": false
    },
    "Zama16b": {
      "supported": false
    },
    "Zawrs": {
      "supported": false,
      "nto": {
        "is_nop": false
      },
      "sto": {
        "is_nop": false
      }
    },
    "Zfa": {
      "supported": false
    },
    "Zfbfmin": {
      "supported": false
    },
    "Zfh": {
      "supported": false
    },
    "Zfhmin": {
      "supported": false
    },
    "Zfinx": {
      "supported": false
    },
    "Zdinx": {
      "supported": false
    },
    "Zca": {
      "supported": true
    },
    "Zcf": {
      "supported": false
    },
    "Zcd": {
      "supported": false
    },
    // RV32ZC = RV32ZcaZcbZcmp.  Zcmp is implemented too but sail-riscv 0.14.1 has no
    // Zcmp knob, so it is neither declared nor tested.
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/ibex_configs.yaml#L46
    "Zcb": {
      "supported": true
    },
    "Zcmop": {
      "supported": false
    },
    // RV32B = RV32BOTEarlGrey, which includes the ratified 1.0.0 Zba, Zbb, Zbc and Zbs.
    // misa.B still reads 0, so the "B" entry above stays false.
    //   Quote: "Ibex fully implements the ratified version 1.0.0 of the RISC-V
    //   Bit-Manipulation Extension including the Zba, Zbb, Zbc and Zbs sub-extensions."
    //   https://github.com/lowRISC/ibex/blob/e9f55342edbd27e9e17a0e41b1c95a81abb5eac8/doc/01_overview/compliance.rst#L87
    "Zba": {
      "supported": true
    },
    "Zbb": {
      "supported": true
    },
    "Zbs": {
      "supported": true
    },
    "Zbc": {
      "supported": true
    },
    "Zbkb": {
      "supported": false
    },
    "Zbkc": {
      "supported": false
    },
    "Zbkx": {
      "supported": false
    },
    "Zknd": {
      "supported": false
    },
    "Zkne": {
      "supported": false
    },
    "Zknh": {
      "supported": false
    },
    "Zkr": {
      "supported": false,
