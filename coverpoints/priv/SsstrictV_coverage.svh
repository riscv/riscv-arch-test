                                {5'd8,  5'd11, 3'b011},  // NFIELDS=4, vs2=vd+3
                                {5'd8,  5'd12, 3'b100},  // NFIELDS=5, vs2=vd+4
                                {5'd8,  5'd13, 3'b101},  // NFIELDS=6, vs2=vd+5
                                {5'd8,  5'd14, 3'b110},  // NFIELDS=7, vs2=vd+6
