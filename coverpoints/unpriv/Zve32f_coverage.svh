    //// end cr_vtype_agnostic////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Zve32f_vmfne_vv_sew32_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cmp_vs1_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cmp_vs1_vs2 : coverpoint ins.get_vr_reg(ins.current.vs1)  iff (ins.current.vs1 == ins.current.vs2 & ins.trap == 0 )  {
        // Compare assignments of all 32 registers
    }

    //// eend cmp_vs1_vs2////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vmfne.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    cp_csr_fflags_v : coverpoint {
        get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "fcsr", "fflags")[4:0],
        get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "fcsr", "fflags")[4:0]
    } iff (ins.trap == 0 )  {
        // Value of FCSR.fflags
        wildcard bins NV   = {10'b0????_1????};
        wildcard bins NV1  = {10'b1????_1????};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_vfp_NaN_input
    //////////////////////////////////////////////////////////////////////////////////

    vs2_element0_sqNAN : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs2_val) {
        bins vs2_0_qNaN = {64'h0000_0000_7FC0_0000}; // qNaN input (canonical single)
        bins vs2_0_sNaN = {64'h0000_0000_7FA0_0000}; // sNaN input (single)
    }

    cp_custom_vfp_NaN_input : cross std_vec, vs2_element0_sqNAN;

    //// end cp_custom_vfp_NaN_input////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_vfp_flags_set
    // Universal flag-set check: every flag-setting FP instruction can raise NV
    // (sNaN input). DZ/NX/OF/UF are covered by per-instruction specific columns.
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_fflags_vdoun_set : coverpoint {
        get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "fcsr", "fflags")[4:0],
        get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "fcsr", "fflags")[4:0]
    } iff (ins.trap == 0 )  {
        wildcard bins NV   = {10'b0????_1????};
        wildcard bins NV1  = {10'b1????_1????};
    }

    cp_custom_vfp_flags_set : cross std_vec, cp_csr_fflags_vdoun_set;

    //// end cp_custom_vfp_flags_set////////////////////////////////////////////////

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment
    }

    //// end cp_vd////////////////////////////////////////////////

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl") {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1 : coverpoint ins.get_vr_reg(ins.current.vs1)  iff (ins.trap == 0 )  {
        // VS1 register assignment
    }

    //// end cp_vs1////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1_edges_f_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1_edges_f_sew32 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs1_val)[31:0]  iff (ins.trap == 0 )  {
        // Standard precision coverpoints
        bins pos0                   = {32'h00000000};
        bins neg0                   = {32'h80000000};
        bins pos1                   = {32'h3F800000};
        bins neg1                   = {32'hBF800000};
        bins posminnorm             = {32'h00800000};
        bins negmaxnorm             = {32'hFF7FFFFF};
        bins posinfinity            = {32'h7F800000};
        bins neginfinity            = {32'hFF800000};
        bins pos0p5                 = {32'h3F000000};
        bins pos1p5                 = {32'h3FC00000};
        bins neg2                   = {32'hC0000000};
        bins pi                     = {32'h40490FDB};
        bins twoToEmax              = {32'h7F000000};   // 2^127
        bins onePulp                = {32'h3F800001};   // 1 + ULP
        bins largestsubnorm         = {32'h007FFFFF};
        bins negSubnormLeadingOne   = {32'h80400000};   // subnormal with MSB of fraction = 1
        bins min_subnorm            = {32'h00000001};
        bins canonicalQNaN          = {32'h7FC00000};   // quiet NaN, canonical payload
        bins negNoncanonicalQNaN    = {[32'hFFC00001:32'hFFFFFFFF]}; // other quiet NaNs
        bins sNaN_payload1          = {32'h7F800001};   // signaling NaN with payload 1
    }

    //// end cp_vs1_edges_f_sew32        //////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_f_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_f_sew32 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs2_val)[31:0]  iff (ins.trap == 0 )  {
        // Standard precision coverpoints
        bins pos0                   = {32'h00000000};
        bins neg0                   = {32'h80000000};
        bins pos1                   = {32'h3F800000};
        bins neg1                   = {32'hBF800000};
        bins posminnorm             = {32'h00800000};
        bins negmaxnorm             = {32'hFF7FFFFF};
        bins posinfinity            = {32'h7F800000};
        bins neginfinity            = {32'hFF800000};
        bins pos0p5                 = {32'h3F000000};
        bins pos1p5                 = {32'h3FC00000};
        bins neg2                   = {32'hC0000000};
        bins pi                     = {32'h40490FDB};
        bins twoToEmax              = {32'h7F000000};   // 2^127
        bins onePulp                = {32'h3F800001};   // 1 + ULP
        bins largestsubnorm         = {32'h007FFFFF};
        bins negSubnormLeadingOne   = {32'h80400000};   // subnormal with MSB of fraction = 1
        bins min_subnorm            = {32'h00000001};
        bins canonicalQNaN          = {32'h7FC00000};   // quiet NaN, canonical payload
        bins negNoncanonicalQNaN    = {[32'hFFC00001:32'hFFFFFFFF]}; // other quiet NaNs
        bins sNaN_payload1          = {32'h7F800001};   // signaling NaN with payload 1
    }

    //// end cp_vs2_edges_f_sew32         //////////////////////////////////////////////////

    std_vec: coverpoint {get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vill") == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vstart", "vstart") == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl") != 0 &
                        ins.trap == 0
                    }
    {
    bins true = {1'b1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_all_sew32_lmul_le_8 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2) {
        // Value of VTYPE.vlmul (vector register grouping), SEW = 32
        `ifdef LMULf2_SUPPORTED
            bins half   = {7};
        `endif
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
    }

    cr_vl_lmul_sew32 : cross cp_csr_vtype_lmul_all_sew32_lmul_le_8, cp_csr_vl_edges  iff (ins.trap == 0 & get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2)  {
        // Cross coverage all legal LMULs for SEW = 32 and vl edges (1, random, vlmax)
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vs2_vs1_edges_f_sew32
    //////////////////////////////////////////////////////////////////////////////////

    cr_vs2_vs1_edges_f_sew32 : cross cp_vs2_edges_f_sew32,cp_vs1_edges_f_sew32  iff (ins.trap == 0 )  {
        // Cross coverage of VS2 edges and VS1 edges
    }

    //// end cr_vs2_vs1_edges_f_sew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0)  {
        // Value of VTYPE.vta (vector tail agnostic)
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_csr_vtype_vma : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0)  {
        // Value of VTYPE.vma (vector mask agnostic)
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    mask_enabled_agnostic: coverpoint ins.current.insn[25] {
        bins enabled = {1'b0};
    }

    cr_vtype_agnostic : cross cp_csr_vtype_vta,cp_csr_vtype_vma,mask_enabled_agnostic iff (ins.trap == 0 )  {
        // Cross coverage of vector tail and mask agnostic behaviors
    }

    //// end cr_vtype_agnostic////////////////////////////////////////////////

endgroup
// ---------------------
function void zve32f_sample(int hart, int issue, ins_t ins);
    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 0 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (traceDataQ[hart][issue][0].inst_name)
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 1 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (traceDataQ[hart][issue][0].inst_name)
        "vfncvt.rtz.x.f.w"     : begin
            Zve32f_vfncvt_rtz_x_f_w_sew@EFFEW@_cg.sample(ins);
        end
        "vfncvt.rtz.xu.f.w"     : begin
            Zve32f_vfncvt_rtz_xu_f_w_sew@EFFEW@_cg.sample(ins);
        end
        "vfncvt.x.f.w"     : begin
            Zve32f_vfncvt_x_f_w_sew@EFFEW@_cg.sample(ins);
        end
        "vfncvt.xu.f.w"     : begin
            Zve32f_vfncvt_xu_f_w_sew@EFFEW@_cg.sample(ins);
        end
        "vfwcvt.f.x.v"     : begin
            Zve32f_vfwcvt_f_x_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfwcvt.f.xu.v"     : begin
            Zve32f_vfwcvt_f_xu_v_sew@EFFEW@_cg.sample(ins);
        end
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 2 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (traceDataQ[hart][issue][0].inst_name)
        "vfadd.vf"     : begin
            Zve32f_vfadd_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfadd.vv"     : begin
            Zve32f_vfadd_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfclass.v"     : begin
            Zve32f_vfclass_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfcvt.f.x.v"     : begin
            Zve32f_vfcvt_f_x_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfcvt.f.xu.v"     : begin
            Zve32f_vfcvt_f_xu_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfcvt.rtz.x.f.v"     : begin
            Zve32f_vfcvt_rtz_x_f_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfcvt.rtz.xu.f.v"     : begin
            Zve32f_vfcvt_rtz_xu_f_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfcvt.x.f.v"     : begin
            Zve32f_vfcvt_x_f_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfcvt.xu.f.v"     : begin
            Zve32f_vfcvt_xu_f_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfdiv.vf"     : begin
            Zve32f_vfdiv_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfdiv.vv"     : begin
            Zve32f_vfdiv_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmacc.vf"     : begin
            Zve32f_vfmacc_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfmacc.vv"     : begin
            Zve32f_vfmacc_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmadd.vf"     : begin
            Zve32f_vfmadd_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfmadd.vv"     : begin
            Zve32f_vfmadd_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmax.vf"     : begin
            Zve32f_vfmax_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfmax.vv"     : begin
            Zve32f_vfmax_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmerge.vfm"     : begin
            Zve32f_vfmerge_vfm_sew@EFFEW@_cg.sample(ins);
        end
        "vfmin.vf"     : begin
            Zve32f_vfmin_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfmin.vv"     : begin
            Zve32f_vfmin_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmsac.vf"     : begin
            Zve32f_vfmsac_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfmsac.vv"     : begin
            Zve32f_vfmsac_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmsub.vf"     : begin
            Zve32f_vfmsub_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfmsub.vv"     : begin
            Zve32f_vfmsub_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmul.vf"     : begin
            Zve32f_vfmul_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfmul.vv"     : begin
            Zve32f_vfmul_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfmv.f.s"     : begin
            Zve32f_vfmv_f_s_sew@EFFEW@_cg.sample(ins);
        end
        "vfmv.s.f"     : begin
            Zve32f_vfmv_s_f_sew@EFFEW@_cg.sample(ins);
        end
        "vfmv.v.f"     : begin
            Zve32f_vfmv_v_f_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmacc.vf"     : begin
            Zve32f_vfnmacc_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmacc.vv"     : begin
            Zve32f_vfnmacc_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmadd.vf"     : begin
            Zve32f_vfnmadd_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmadd.vv"     : begin
            Zve32f_vfnmadd_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmsac.vf"     : begin
            Zve32f_vfnmsac_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmsac.vv"     : begin
            Zve32f_vfnmsac_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmsub.vf"     : begin
            Zve32f_vfnmsub_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfnmsub.vv"     : begin
            Zve32f_vfnmsub_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfrdiv.vf"     : begin
            Zve32f_vfrdiv_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfrec7.v"     : begin
            Zve32f_vfrec7_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfredmax.vs"     : begin
            Zve32f_vfredmax_vs_sew@EFFEW@_cg.sample(ins);
        end
        "vfredmin.vs"     : begin
            Zve32f_vfredmin_vs_sew@EFFEW@_cg.sample(ins);
        end
        "vfredosum.vs"     : begin
            Zve32f_vfredosum_vs_sew@EFFEW@_cg.sample(ins);
        end
        "vfredusum.vs"     : begin
            Zve32f_vfredusum_vs_sew@EFFEW@_cg.sample(ins);
        end
        "vfrsqrt7.v"     : begin
            Zve32f_vfrsqrt7_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfrsub.vf"     : begin
            Zve32f_vfrsub_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfsgnj.vf"     : begin
            Zve32f_vfsgnj_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfsgnj.vv"     : begin
            Zve32f_vfsgnj_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfsgnjn.vf"     : begin
            Zve32f_vfsgnjn_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfsgnjn.vv"     : begin
            Zve32f_vfsgnjn_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfsgnjx.vf"     : begin
            Zve32f_vfsgnjx_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfsgnjx.vv"     : begin
            Zve32f_vfsgnjx_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vfslide1down.vf"     : begin
            Zve32f_vfslide1down_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfslide1up.vf"     : begin
            Zve32f_vfslide1up_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfsqrt.v"     : begin
            Zve32f_vfsqrt_v_sew@EFFEW@_cg.sample(ins);
        end
        "vfsub.vf"     : begin
            Zve32f_vfsub_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vfsub.vv"     : begin
            Zve32f_vfsub_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vmfeq.vf"     : begin
            Zve32f_vmfeq_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vmfeq.vv"     : begin
            Zve32f_vmfeq_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vmfge.vf"     : begin
            Zve32f_vmfge_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vmfgt.vf"     : begin
            Zve32f_vmfgt_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vmfle.vf"     : begin
            Zve32f_vmfle_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vmfle.vv"     : begin
            Zve32f_vmfle_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vmflt.vf"     : begin
            Zve32f_vmflt_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vmflt.vv"     : begin
            Zve32f_vmflt_vv_sew@EFFEW@_cg.sample(ins);
        end
        "vmfne.vf"     : begin
            Zve32f_vmfne_vf_sew@EFFEW@_cg.sample(ins);
        end
        "vmfne.vv"     : begin
            Zve32f_vmfne_vv_sew@EFFEW@_cg.sample(ins);
        end
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 3 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (traceDataQ[hart][issue][0].inst_name)
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
endfunction
