    mstatus_fs_state : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "mstatus", "fs") {
        `ifdef UDB_MSTATUS_FS_LEGAL_VALUES_1
            bins fs_initial = {1};
